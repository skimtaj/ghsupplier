<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes, viewport-fit=cover" />
    <title>NM - View Results</title>
    <!-- Fonts & Libraries -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.3/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.2.9/css/responsive.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>

    <style>
        /* ----- RESET & VARIABLES ----- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        body {
            background: #f4f0f5;
            min-height: 100vh;
            color: #1e1a2b;
            -webkit-font-smoothing: antialiased;
        }

        :root {
            --primary: #4F0853;
            --primary-light: #6d1a72;
            --primary-dark: #2e0431;
            --white: #ffffff;
            --shadow: 0 2px 8px rgba(79, 8, 83, 0.08);
            --shadow-md: 0 4px 16px rgba(79, 8, 83, 0.10);
            --border: #d6cedb;
            --sidebar: 260px;
        }

        /* ----- MAIN CONTENT (respects your sidebar) ----- */
        .container {
            margin-top: 50px;
            margin-left: var(--sidebar);
            padding: 24px 32px;
            max-width: calc(100% - var(--sidebar));
            width: 100%;
        }

        .main {
            display: grid;
            gap: 20px;
            width: 100%;
            grid-template-columns: 1fr;
            margin-top: 10px;
        }

        /* ----- RESPONSIVE - adjusts with your sidebar ----- */
        @media (max-width: 991.98px) {
            .container {
                margin-left: 0;
                max-width: 100%;
                padding: 16px 20px;
            }
        }

        @media (max-width: 575.98px) {
            .container {
                padding: 10px 12px;
            }

            .main {
                gap: 12px;
            }

            .data-table-header {
                padding: 0.8rem 1rem;
                flex-direction: column;
                align-items: stretch;
            }

            .data-table-title h3 {
                font-size: 1.1rem;
            }

            .table-responsive-wrapper {
                padding: 0 0.6rem 1rem 0.6rem;
            }

            table.dataTable thead th,
            table.dataTable tbody td {
                padding: 6px 6px;
                font-size: 0.65rem;
            }

            .btn-view-result {
                font-size: 0.6rem;
                padding: 0.15rem 0.7rem;
            }
        }

        @media (min-width: 576px) and (max-width: 767.98px) {
            .container {
                padding: 16px 18px;
            }

            .data-table-header {
                padding: 0.9rem 1.2rem;
            }

            .table-responsive-wrapper {
                padding: 0 1rem 1.2rem 1rem;
            }
        }

        /* ----- DATA TABLE (clean, no filters, no profile) ----- */
        .data-table-container {
            background: var(--white);
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            overflow: hidden;
            transition: box-shadow 0.2s;
        }

        .data-table-container:hover {
            box-shadow: 0 8px 28px rgba(79, 8, 83, 0.12);
        }

        .data-table-header {
            padding: 1.2rem 1.8rem;
            background: #ffffff;
            border-bottom: 1px solid rgba(79, 8, 83, 0.08);
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 15px;
        }

        .data-table-title h3 {
            font-weight: 700;
            margin: 0;
            font-size: 1.4rem;
            color: var(--primary-dark);
            letter-spacing: -0.3px;
        }

        .data-table-title p {
            margin: 0;
            font-size: 0.8rem;
            color: #6b5f6f;
            font-weight: 400;
        }

        .table-responsive-wrapper {
            padding: 0 1.5rem 1.8rem 1.5rem;
            overflow-x: auto;
        }

        /* View button */
        .btn-view-result {
            background: var(--primary);
            color: white;
            border: none;
            padding: 0.25rem 1rem;
            font-size: 0.7rem;
            font-weight: 600;
            border-radius: 20px;
            transition: all 0.15s;
            letter-spacing: 0.3px;
            box-shadow: 0 2px 4px rgba(79, 8, 83, 0.15);
        }

        .btn-view-result:hover {
            background: var(--primary-light);
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(79, 8, 83, 0.25);
            color: white;
        }

        /* DataTable styles */
        table.dataTable {
            width: 100% !important;
            border-collapse: separate;
            border-spacing: 0;
            margin-top: 0.25rem !important;
        }

        table.dataTable thead th {
            padding: 14px 12px;
            background: #f8f4fa;
            font-weight: 700;
            font-size: 0.8rem;
            color: var(--primary-dark);
            border-bottom: 2px solid var(--primary);
            white-space: nowrap;
        }

        table.dataTable tbody td {
            padding: 12px 12px;
            font-size: 0.8rem;
            vertical-align: middle;
            border-bottom: 1px solid #edeaf0;
        }

        table.dataTable tbody tr:hover {
            background: #faf7fc;
        }

        .fade-in {
            animation: fadeInUp 0.4s ease forwards;
            opacity: 0;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Pagination */
        .dataTables_paginate .paginate_button {
            padding: 0.2rem 0.8rem !important;
            margin: 0 2px !important;
            font-size: 0.75rem !important;
            border-radius: 0 !important;
            border: 1px solid #c5b8cb !important;
            background: white !important;
            color: #1e1a2b !important;
        }

        .dataTables_paginate .paginate_button.current {
            background: #d9b0dd !important;
            border-color: #b48ab8 !important;
            color: var(--primary-dark) !important;
            font-weight: 600 !important;
        }

        .dataTables_paginate .paginate_button:hover {
            background: #e8d4eb !important;
            border-color: #b48ab8 !important;
            color: var(--primary-dark) !important;
        }

        .dataTables_length select {
            padding: 0.1rem 0.4rem;
            font-size: 0.75rem;
            border-radius: 0;
            border: 1px solid #d6cedb;
        }

        .dataTables_info {
            font-size: 0.75rem;
            color: #4b3f4f;
        }

        .dataTables_filter input {
            font-size: 0.75rem;
            padding: 0.2rem 0.6rem;
            border-radius: 0;
            border: 1px solid #d6cedb;
        }

        .dataTables_filter input:focus {
            border-color: var(--primary);
            outline: none;
            box-shadow: 0 0 0 2px rgba(79, 8, 83, 0.12);
        }

        ::-webkit-scrollbar {
            width: 4px;
            height: 4px;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--primary);
            border-radius: 0;
        }

        /* Hide all unnecessary elements */
        .filter-group,
        .filter-item,
        .btn-show-records,
        .btn-add-new,
        .admin-profile-section,
        .stats-row,
        .stats-box,
        .admin-profile-img-container,
        .admin-profile-info,
        .admin-profile-details {
            display: none !important;
        }

        /* ===== NEW: Static summary card ===== */
        .summary-card {
            background: var(--white);
            border-radius: 16px;
            box-shadow: var(--shadow-md);
            padding: 1.2rem 1.8rem;
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            justify-content: space-between;
            gap: 16px 24px;
            transition: box-shadow 0.2s;
            border-left: 4px solid var(--primary);
        }

        .summary-card:hover {
            box-shadow: 0 8px 28px rgba(79, 8, 83, 0.12);
        }

        .summary-item {
            display: flex;
            align-items: baseline;
            gap: 6px 12px;
            flex-wrap: wrap;
        }

        .summary-item .label {
            font-size: 0.8rem;
            font-weight: 500;
            color: #6b5f6f;
            letter-spacing: 0.3px;
            text-transform: uppercase;
        }

        .summary-item .value {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--primary-dark);
            background: #f4f0f5;
            padding: 0.1rem 0.9rem;
            border-radius: 40px;
            line-height: 1.6;
        }

        .summary-item .value.obtained {
            background: #e6dce8;
            color: var(--primary);
        }

        .summary-item .value.remark {
            background: #d9b0dd;
            color: var(--primary-dark);
            font-size: 1rem;
            padding: 0.1rem 1.2rem;
        }

        .summary-divider {
            width: 1px;
            height: 32px;
            background: #d6cedb;
            display: inline-block;
        }

        @media (max-width: 575.98px) {
            .summary-card {
                padding: 1rem 1rem;
                flex-direction: column;
                align-items: stretch;
                gap: 10px;
            }

            .summary-item {
                justify-content: space-between;
            }

            .summary-divider {
                display: none;
            }
        }
    </style>
</head>

<body>
    <!-- Your custom sidebar goes here (provided by your EJS include) -->
    <%- include('teacher_sidebar') %>

        <!-- ===== MAIN CONTENT ===== -->
        <div class="container" id="top">
            <main class="content">
                <div class="main">
                    <!-- ===== STATIC SUMMARY CARD (total, obtained, remark) ===== -->
                    <div class="summary-card fade-in">
                        <div class="summary-item">
                            <span class="label">Total Marks</span>
                            <span class="value">
                                <%=resultSourse.total_fm%>
                            </span>
                        </div>
                        <div class="summary-divider"></div>
                        <div class="summary-item">
                            <span class="label">Obtained</span>
                            <span class="value obtained">
                                <%=resultSourse.total_om%>
                            </span>
                        </div>
                        <div class="summary-divider"></div>
                        <div class="summary-item">
                            <span class="label">Percentage (%)</span>
                            <span class="value remark">
                                <%=resultSourse.result_percentage%>
                            </span>
                        </div>


                        <div class="summary-divider"></div>
                        <div class="summary-item">
                            <span class="label">Remark</span>
                            <span class="value remark">
                                <%=resultSourse.result_status%>
                            </span>
                        </div>


                    </div>

                    <!-- ===== STUDENT RESULT LIST ===== -->
                    <div class="data-table-container fade-in">
                        <div class="data-table-header">
                            <div class="data-table-title">
                                <h3><i class="fas fa-graduation-cap"
                                        style="color: var(--primary); margin-right: 8px;"></i>
                                    <%= resultSourse.student_name %>
                                </h3>
                                <p>All recorded results · updated regularly</p>
                            </div>
                            <!-- No filters, no add button -->
                        </div>
                        <div class="table-responsive-wrapper">
                            <table id="masterDirectoryTable" class="display responsive nowrap" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Subject</th>
                                        <th>Full Marks</th>
                                        <th>Obtained Marks</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% resultSourse.result.forEach((r)=>{ %>
                                        <tr>
                                            <td>
                                                <%= r.subject %>
                                            </td>
                                            <td>
                                                <%= r.fm %>
                                            </td>
                                            <td>
                                                <%= r.om %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </main>
        </div>

        <script>
            $(document).ready(function () {
                // DataTable initialization
                var table = $('#masterDirectoryTable').DataTable({
                    responsive: true,
                    pageLength: 8,
                    lengthMenu: [5, 8, 15, 25, 50],
                    language: {
                        search: '<i class="fas fa-search" style="margin-right:4px;"></i> Filter:',
                        lengthMenu: "Show _MENU_ entries",
                        info: "Showing _START_ to _END_ of _TOTAL_ results",
                        infoEmpty: "No entries",
                        infoFiltered: "(filtered from _MAX_ total entries)",
                        paginate: {
                            next: '<i class="fas fa-chevron-right"></i>',
                            previous: '<i class="fas fa-chevron-left"></i>'
                        }
                    },
                    columnDefs: [
                        { responsivePriority: 1, targets: 0 },
                        { responsivePriority: 2, targets: 1 },
                        { orderable: false, targets: 5 }
                    ],
                    drawCallback: function () {
                        $('.dataTables_paginate .paginate_button').css({
                            'border-radius': '0',
                            'padding': '0.2rem 0.8rem',
                            'font-size': '0.75rem'
                        });
                    }
                });

                // View button click handler (kept for compatibility)
                $('#masterDirectoryTable tbody').on('click', '.btn-view-result', function () {
                    var rowData = table.row($(this).closest('tr')).data();
                    console.log('View result for:', rowData ? rowData[2] : 'student');
                });

                console.log('✅ Student Result List with static summary ready.');
            });
        </script>
</body>

</html>