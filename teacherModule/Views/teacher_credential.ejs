<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Login - Nababia Mission</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Roboto, system-ui, sans-serif;
        }

        html,
        body {
            height: 100%;
            width: 100%;
            background: #f2ebf5;
        }

        body {
            display: flex;
            min-height: 100vh;
        }

        .auth-container {
            display: flex;
            width: 100%;
            min-height: 100vh;
            flex-direction: row-reverse;
        }

        /* ----- LEFT PANEL : FULL COVER IMAGE, EDGE TO EDGE ----- */
        .auth-left {
            flex: 1 1 50%;
            width: 50%;
            height: 100vh;
            background: #1e0a24;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            padding: 0;
            margin: 0;
            position: relative;
        }

        .auth-left-content {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0;
            margin: 0;
            line-height: 0;
            flex-shrink: 0;
        }

        .auth-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            display: block;
            border-radius: 0;
            box-shadow: none;
            margin: 0;
            padding: 0;
            vertical-align: bottom;
            min-width: 100%;
            min-height: 100%;
            flex-shrink: 0;
        }

        /* ----- RIGHT PANEL (login form) – takes other 50% ----- */
        .auth-right {
            flex: 1 1 50%;
            width: 50%;
            min-height: 100vh;
            background-color: #f8f4fc;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }

        .auth-right::before {
            content: '';
            position: absolute;
            top: 0;
            right: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #510855, #2d1040);
            clip-path: circle(40% at 90% 10%);
            z-index: 1;
            opacity: 0.06;
        }

        .auth-right::after {
            content: '';
            position: absolute;
            bottom: 0;
            right: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(135deg, #510855, #2d1040);
            clip-path: circle(30% at 10% 90%);
            z-index: 1;
            opacity: 0.06;
        }

        .auth-content {
            max-width: 400px;
            width: 100%;
            z-index: 2;
        }

        .logo {
            display: flex;
            align-items: center;
            margin-bottom: 2rem;
        }

        .logo img {
            height: 40px;
            margin-right: 10px;
            border-radius: 8px;
            border: 2px solid #510855;
            object-fit: cover;
        }

        .logo h1 {
            font-size: 1.5rem;
            color: #1e0a24;
            font-weight: 700;
        }

        .admin-badge {
            background-color: #510855;
            color: white;
            padding: 0.2rem 0.7rem;
            border-radius: 20px;
            font-size: 0.7rem;
            font-weight: 600;
            margin-left: 0.5rem;
            letter-spacing: 0.3px;
        }

        .auth-form {
            background-color: #ffffff;
            padding: 2rem;
            border-radius: 18px;
            box-shadow: 0 12px 30px rgba(81, 8, 85, 0.12);
            border: 1px solid rgba(81, 8, 85, 0.06);
        }

        .auth-header {
            margin-bottom: 1.5rem;
        }

        .auth-header h2 {
            font-size: 1.5rem;
            color: #1e0a24;
            margin-bottom: 0.4rem;
        }

        .auth-header p {
            color: #6b4a72;
            font-size: 0.875rem;
        }

        .form-group {
            margin-bottom: 1.25rem;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-size: 0.875rem;
            color: #1e0a24;
            font-weight: 500;
        }

        .form-control {
            width: 100%;
            padding: 0.75rem 1rem;
            border: 1px solid #dacce0;
            border-radius: 10px;
            font-size: 0.875rem;
            transition: all 0.25s ease;
            background-color: #fcf9fd;
        }

        .form-control:focus {
            outline: none;
            border-color: #510855;
            box-shadow: 0 0 0 4px rgba(81, 8, 85, 0.15);
            background-color: #ffffff;
        }

        .input-with-icon {
            position: relative;
        }

        .input-with-icon .form-control {
            padding-left: 2.8rem;
        }

        .input-icon {
            position: absolute;
            left: 1rem;
            top: 50%;
            transform: translateY(-50%);
            color: #6b4a72;
            font-size: 1rem;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 0.8rem 1.5rem;
            border-radius: 30px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.25s ease;
            border: none;
            letter-spacing: 0.3px;
        }

        .btn-primary {
            background-color: #510855;
            color: white;
            width: 100%;
            box-shadow: 0 6px 14px rgba(81, 8, 85, 0.25);
        }

        .btn-primary:hover {
            background-color: #7a2a7e;
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(81, 8, 85, 0.3);
        }

        .btn-primary:active {
            transform: translateY(0);
        }

        .auth-footer {
            margin-top: 1.5rem;
            text-align: center;
            font-size: 0.875rem;
            color: #6b4a72;
        }

        .auth-footer a {
            color: #510855;
            text-decoration: none;
            font-weight: 600;
            cursor: pointer;
        }

        .auth-footer a:hover {
            text-decoration: underline;
            color: #7a2a7e;
        }

        .password-toggle {
            position: absolute;
            right: 1rem;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #6b4a72;
            font-size: 1rem;
        }

        .password-toggle:hover {
            color: #510855;
        }

        .error-message {
            color: #e84c6b;
            font-size: 0.75rem;
            margin-top: 0.25rem;
            display: none;
        }

        .form-group.error .error-message {
            display: block;
        }

        .form-group.error .form-control {
            border-color: #e84c6b;
        }

        /* ----- MODALS (light) ----- */
        .modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(30, 10, 36, 0.5);
            backdrop-filter: blur(4px);
            z-index: 1000;
            justify-content: center;
            align-items: center;
        }

        .modal-content {
            background-color: white;
            padding: 2rem 2rem 2.2rem;
            border-radius: 24px;
            width: 90%;
            max-width: 440px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 25px 50px rgba(0, 0, 0, 0.2);
            position: relative;
            border: 1px solid rgba(81, 8, 85, 0.08);
        }

        .close-modal {
            position: absolute;
            top: 1rem;
            right: 1.2rem;
            font-size: 1.6rem;
            cursor: pointer;
            color: #6b4a72;
            transition: 0.2s;
            line-height: 1;
        }

        .close-modal:hover {
            color: #1e0a24;
            transform: rotate(90deg);
        }

        .modal-header {
            margin-bottom: 1.5rem;
        }

        .modal-header h2 {
            font-size: 1.5rem;
            color: #1e0a24;
            margin-bottom: 0.4rem;
        }

        .modal-header p {
            color: #6b4a72;
            font-size: 0.9rem;
        }

        /* ===== RESPONSIVE: on smaller screens stack vertically ===== */
        @media (max-width: 1024px) {
            .auth-container {
                flex-direction: column;
            }

            .auth-left {
                width: 100%;
                height: 50vh;
                flex: none;
            }

            .auth-right {
                width: 100%;
                min-height: 50vh;
                flex: none;
            }

            .auth-image {
                width: 100%;
                height: 100%;
                object-fit: cover;
            }
        }

        @media (max-width: 480px) {
            .auth-form {
                padding: 1.25rem;
            }

            .auth-content {
                padding: 0.25rem;
            }

            .logo h1 {
                font-size: 1.2rem;
            }

            .auth-header h2 {
                font-size: 1.2rem;
            }

            .form-control {
                padding: 0.6rem 0.8rem;
            }

            .input-with-icon .form-control {
                padding-left: 2.4rem;
            }

            .btn {
                padding: 0.6rem 1rem;
            }

            .modal-content {
                padding: 1.5rem;
            }

            .auth-right {
                padding: 1rem;
            }

            .auth-left {
                height: 40vh;
                padding: 0;
            }
        }
    </style>
</head>

<body>

    <% if (messages.success) { %>
        <script>
            Swal.fire({
                toast: true,
                position: "top-end",
                icon: "success",
                title: "<%= messages.success %>",
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                background: "#ffffff",
                iconColor: "#00b894",
                color: "#333",
                customClass: {
                    popup: 'custom-swal-toast'
                },
                didOpen: (toast) => {
                    toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.1)';
                    toast.style.borderRadius = '8px';
                    toast.style.padding = '0.75rem 1.25rem';
                }
            });
        </script>
        <% } %>

            <% if (messages.error) { %>
                <script>
                    Swal.fire({
                        toast: true,
                        position: "top-end",
                        icon: "error",
                        title: "<%= messages.error %>",
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                        background: "#ffffff",
                        iconColor: "#red",
                        color: "#333",
                        customClass: {
                            popup: 'custom-swal-toast'
                        },
                        didOpen: (toast) => {
                            toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.1)';
                            toast.style.borderRadius = '8px';
                            toast.style.padding = '0.75rem 1.25rem';
                        }
                    });
                </script>
                <% } %>

                    <div class="auth-container">

                        <!-- LEFT PANEL : IMAGE FULL COVER -->
                        <div class="auth-left">
                            <div class="auth-left-content">
                                <img src="https://nababiamission.org/wp-content/uploads/2026/06/A2.jpeg"
                                    alt="Nababia Mission" class="auth-image">
                            </div>
                        </div>

                        <!-- RIGHT PANEL : LOGIN FORM -->
                        <div class="auth-right">
                            <div class="auth-content">
                                <div class="logo">
                                    <img src="https://nababiamission.org/wp-content/uploads/2026/05/unnamed-file.jpg"
                                        alt="Nababia Mission">
                                    <h1>Nababia Mission<span class="admin-badge">Teacher</span></h1>
                                </div>

                                <div class="auth-form">
                                    <div class="auth-header">
                                        <h2>Teacher Sign In</h2>
                                        <p>Restricted area · authorized personnel only</p>
                                    </div>

                                    <form id="loginForm" method="post" action="/nababiamission/teacher-signin">
                                        <div class="form-group">
                                            <label for="email">Teacher Email</label>
                                            <div class="input-with-icon">
                                                <i class="fas fa-envelope input-icon"></i>
                                                <input type="email" id="email" class="form-control"
                                                    placeholder="admin@domain.com" required name="email">
                                            </div>
                                            <div class="error-message">Please enter a valid teacher email</div>
                                        </div>

                                        <div class="form-group">
                                            <label for="password">Password</label>
                                            <div class="input-with-icon">
                                                <i class="fas fa-lock input-icon"></i>
                                                <input type="password" id="password" class="form-control"
                                                    placeholder="••••••••" required name="password">
                                                <i class="fas fa-eye password-toggle" id="togglePassword"></i>
                                            </div>
                                            <div class="error-message">Password must be at least 8 characters</div>
                                        </div>

                                        <div class="form-group"
                                            style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap;">
                                            <div style="display: flex; align-items: center;">
                                                <input type="checkbox" id="remember"
                                                    style="margin-right: 0.5rem; accent-color: #510855;">
                                                <label for="remember"
                                                    style="margin-bottom: 0; font-size: 0.875rem; color: #6b4a72;">Remember
                                                    me</label>
                                            </div>
                                            
                                        </div>

                                        <button type="submit" class="btn btn-primary">
                                            <i class="fas fa-sign-in-alt" style="margin-right: 8px;"></i> Sign In
                                        </button>
                                    </form>


                                </div>
                            </div>
                        </div>
                    </div>

                    
                    <script>
                        document.addEventListener('DOMContentLoaded', function () {
                            // DOM refs
                            const togglePassword = document.getElementById('togglePassword');
                            const password = document.getElementById('password');

                            const helpModal = document.getElementById('helpModal');
                            const openHelp = document.getElementById('openHelp');
                            const closeHelp = document.getElementById('closeHelp');
                            const closeHelpBtn = document.getElementById('closeHelpBtn');

                            const forgotPasswordModal = document.getElementById('forgotPasswordModal');
                            const forgotPasswordLink = document.getElementById('forgotPasswordLink');
                            const closeForgotPassword = document.getElementById('closeForgotPassword');
                            const backToLogin = document.getElementById('backToLogin');

                            // Toggle password visibility (login)
                            if (togglePassword && password) {
                                togglePassword.addEventListener('click', function () {
                                    const type = password.getAttribute('type') === 'password' ? 'text' : 'password';
                                    password.setAttribute('type', type);
                                    this.classList.toggle('fa-eye-slash');
                                });
                            }

                            // --- Open Help modal (Need help?) ---
                            if (openHelp) {
                                openHelp.addEventListener('click', function (e) {
                                    e.preventDefault();
                                    helpModal.style.display = 'flex';
                                    document.body.style.overflow = 'hidden';
                                });
                            }

                            // Close Help modal (X)
                            if (closeHelp) {
                                closeHelp.addEventListener('click', function () {
                                    helpModal.style.display = 'none';
                                    document.body.style.overflow = 'auto';
                                });
                            }
                            if (closeHelpBtn) {
                                closeHelpBtn.addEventListener('click', function () {
                                    helpModal.style.display = 'none';
                                    document.body.style.overflow = 'auto';
                                });
                            }

                            // --- Open FORGOT PASSWORD modal ---
                            if (forgotPasswordLink) {
                                forgotPasswordLink.addEventListener('click', function (e) {
                                    e.preventDefault();
                                    forgotPasswordModal.style.display = 'flex';
                                    document.body.style.overflow = 'hidden';
                                });
                            }
                            if (closeForgotPassword) {
                                closeForgotPassword.addEventListener('click', function () {
                                    forgotPasswordModal.style.display = 'none';
                                    document.body.style.overflow = 'auto';
                                });
                            }
                            if (backToLogin) {
                                backToLogin.addEventListener('click', function (e) {
                                    e.preventDefault();
                                    forgotPasswordModal.style.display = 'none';
                                    document.body.style.overflow = 'auto';
                                });
                            }

                            // Close modals on outside click
                            window.addEventListener('click', function (e) {
                                if (e.target === helpModal) {
                                    helpModal.style.display = 'none';
                                    document.body.style.overflow = 'auto';
                                }
                                if (e.target === forgotPasswordModal) {
                                    forgotPasswordModal.style.display = 'none';
                                    document.body.style.overflow = 'auto';
                                }
                            });

                            // Simple validation for login
                            const loginForm = document.getElementById('loginForm');
                            if (loginForm) {
                                loginForm.addEventListener('submit', function (e) {
                                    const email = document.getElementById('email');
                                    const pwd = document.getElementById('password');
                                    let valid = true;

                                    if (!email.value || !email.value.includes('@')) {
                                        email.closest('.form-group').classList.add('error');
                                        valid = false;
                                    } else {
                                        email.closest('.form-group').classList.remove('error');
                                    }

                                    if (!pwd.value || pwd.value.length < 8) {
                                        pwd.closest('.form-group').classList.add('error');
                                        valid = false;
                                    } else {
                                        pwd.closest('.form-group').classList.remove('error');
                                    }

                                    if (!valid) {
                                        e.preventDefault();
                                    }
                                });
                            }
                        });
                    </script>

</body>

</html>