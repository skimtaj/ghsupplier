<!DOCTYPE html>
<html lang="en">
<%-include('teacher_sidebar')%>

    <head>
        <meta charset="UTF-8" />
        <meta name="viewport"
            content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes, viewport-fit=cover" />
        <title>NM - Teacher Dashboard</title>
        <!-- Fonts & Libraries -->
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" />
        <link rel="stylesheet" href="https://cdn.datatables.net/1.11.3/css/jquery.dataTables.min.css" />
        <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.2.9/css/responsive.dataTables.min.css" />
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script>
        <script src="https://cdn.datatables.net/responsive/2.2.9/js/dataTables.responsive.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <style>
            /* ----- RESET & VARIABLES ----- */
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            }

            body {
                background: #f4f0f5;
                min-height: 100vh;
                color: #1e1a2b;
                -webkit-font-smoothing: antialiased;
            }

            :root {
                --primary: #4F0853;
                --primary-light: #6d1a72;
                --primary-dark: #2e0431;
                --white: #ffffff;
                --gray-bg: #f8f6fa;
                --border: #d6cedb;
                --shadow: 0 2px 8px rgba(79, 8, 83, 0.08);
                --shadow-md: 0 4px 16px rgba(79, 8, 83, 0.10);
                --shadow-lg: 0 12px 28px rgba(79, 8, 83, 0.12);
                --sidebar: 260px;
            }

            .container {
                width: 100%;
                padding: 12px 16px;
                margin: 0 auto;
            }

            .main {
                display: grid;
                gap: 20px;
                width: 100%;
                grid-template-columns: 1fr;
                margin-top: 50px;
            }

            @media (max-width:575.98px) {
                .container {
                    padding: 8px 10px;
                }

                .main {
                    gap: 12px;
                    margin-top: 42px;
                }

                .admin-profile-section {
                    padding: 0.8rem;
                    flex-direction: column;
                    align-items: flex-start;
                }

                .admin-profile-img {
                    width: 48px;
                    height: 48px;
                }

                .admin-profile-name {
                    font-size: 0.95rem;
                    flex-wrap: wrap;
                }

                .stats-row {
                    grid-template-columns: 1fr !important;
                    gap: 8px;
                }

                .stats-box {
                    padding: 0.6rem 0.8rem;
                }

                .stats-value {
                    font-size: 1rem;
                }

                
            }

            @media (min-width:576px) and (max-width:767.98px) {
                .container {
                    padding: 12px 16px;
                }

                .stats-row {
                    grid-template-columns: 1fr !important;
                    gap: 10px;
                }

               
            }

            @media (min-width:768px) and (max-width:991.98px) {
                .container {
                    padding: 16px 20px;
                }

                .stats-row {
                    grid-template-columns: repeat(2, 1fr);
                }

                
            }

            @media (min-width:992px) {
                .container {
                    margin-left: var(--sidebar);
                    padding: 24px 32px;
                    max-width: calc(100% - var(--sidebar));
                }

                .main {
                    gap: 22px;
                    margin-top: 58px;
                }

                .stats-row {
                    grid-template-columns: repeat(4, 1fr);
                    gap: 16px;
                }

                .stats-box {
                    padding: 1rem 1.5rem;
                }

                .stats-value {
                    font-size: 1.6rem;
                }

                
            }

            /* ----- ADMIN PROFILE ----- */
            .admin-profile-section {
                display: flex;
                align-items: center;
                padding: 1.5rem;
                background: linear-gradient(135deg, rgba(79, 8, 83, 0.96), rgba(46, 4, 49, 0.98)),
                    url('https://images.unsplash.com/photo-1531482615713-2afd69097998?q=80&w=2070&auto=format') center/cover no-repeat;
                border-radius: 16px;
                box-shadow: var(--shadow-lg);
                gap: 1rem;
                color: white;
                position: relative;
                overflow: hidden;
            }

            .admin-profile-section::before {
                content: '';
                position: absolute;
                top: -50%;
                right: -20%;
                width: 300px;
                height: 300px;
                background: radial-gradient(circle, rgba(79, 8, 83, 0.15), transparent 70%);
                border-radius: 50%;
            }

            .admin-profile-img {
                width: 70px;
                height: 70px;
                border-radius: 50%;
                object-fit: cover;
                border: 3px solid #d9b0dd;
            }

            .admin-status-indicator {
                position: absolute;
                bottom: 2px;
                right: 4px;
                width: 14px;
                height: 14px;
                background: #b48ab8;
                border: 2px solid var(--primary);
                border-radius: 50%;
            }

            .admin-profile-info {
                flex: 1;
                z-index: 1;
            }

            .admin-profile-name {
                font-size: 1.25rem;
                font-weight: 800;
                display: flex;
                flex-wrap: wrap;
                align-items: center;
                gap: 0.6rem;
            }

            .admin-profile-badge {
                font-size: 0.7rem;
                background: #d9b0dd;
                color: var(--primary-dark);
                padding: 0.2rem 0.7rem;
                border-radius: 30px;
                font-weight: 700;
            }

            .admin-profile-detail {
                display: flex;
                align-items: center;
                gap: 0.6rem;
                font-size: 0.8rem;
                opacity: 0.92;
            }

            .admin-profile-detail i {
                color: #d9b0dd;
                width: 16px;
            }

            /* ----- STATS ----- */
            .stats-row {
                display: grid;
                gap: 14px;
                grid-template-columns: repeat(4, 1fr);
            }

            .stats-box {
                display: flex;
                align-items: center;
                justify-content: space-between;
                background: var(--white);
                padding: 0.85rem 1.25rem;
                border-radius: 12px;
                box-shadow: var(--shadow);
                border-left: 4px solid var(--primary);
                transition: all 0.2s;
            }

            .stats-box:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 25px rgba(79, 8, 83, 0.12);
            }

            .stats-value {
                font-size: 1.5rem;
                font-weight: 800;
                color: var(--primary-dark);
                margin-bottom: 0.2rem;
            }

            .stats-label {
                font-size: 0.7rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.6px;
                color: #4b3f4f;
                opacity: 0.8;
            }

            

            
            
            

           

         

            

            
        

          
           

       

      

           

          


           

            @keyframes fadeInUp {
                from {
                    opacity: 0;
                    transform: translateY(12px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }

            ::-webkit-scrollbar {
                width: 4px;
                height: 4px;
            }

            ::-webkit-scrollbar-thumb {
                background: var(--primary);
                border-radius: 0;
            }

            .admin-profile-actions {
                display: none !important;
            }

            
        </style>
    </head>

    <body>

        <% if (messages.success) { %>
            <script>
                Swal.fire({ toast: true, position: "top-end", icon: "success", title: "<%= messages.success %>", showConfirmButton: false, timer: 3000, timerProgressBar: true });
            </script>
            <% } %>
                <% if (messages.error) { %>
                    <script>
                        Swal.fire({ toast: true, position: "top-end", icon: "error", title: "<%= messages.error %>", showConfirmButton: false, timer: 3000, timerProgressBar: true });
                    </script>
                    <% } %>

                        <div class="sidebar-placeholder"></div>
                        <div class="container" id="top">
                            <main class="content">
                                <div class="main">

                                    <!-- ===== ADMIN PROFILE ===== -->
                                    <div class="admin-profile-section fade-in">
                                        <div class="admin-profile-img-container"
                                            style="position:relative; flex-shrink:0; z-index:1;">
                                            <img src="https://img.freepik.com/premium-vector/avatar-profile-icon-flat-style-male-user-profile-vector-illustration-isolated-background-man-profile-sign-business-concept_157943-38764.jpg"
                                                alt="Admin" class="admin-profile-img">
                                            <div class="admin-status-indicator"></div>
                                        </div>
                                        <div class="admin-profile-info">
                                            <h3 class="admin-profile-name">
                                                Nababia Mission <span class="admin-profile-badge">Teacher</span>
                                            </h3>
                                            <div class="admin-profile-details">
                                                <div class="admin-profile-detail"><i class="fas fa-phone-alt"></i><span>
                                                        9732381000
                                                    </span></div>
                                                <div class="admin-profile-detail"><i class="fas fa-envelope"></i><span>
                                                        example@gmail.com
                                                    </span></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- ===== STATS ROW ===== -->
                                    <div class="stats-row">
                                        <div class="stats-box fade-in">
                                            <div class="stats-details">
                                                <h4 class="stats-value">
                                                    00
                                                </h4><span class="stats-label">Total Students</span>
                                            </div>
                                        </div>
                                        <div class="stats-box fade-in">
                                            <div class="stats-details">
                                                <h4 class="stats-value">
                                                    00
                                                </h4><span class="stats-label">Boys</span>
                                            </div>
                                        </div>
                                        <div class="stats-box fade-in">
                                            <div class="stats-details">
                                                <h4 class="stats-value">
                                                    00
                                                </h4><span class="stats-label">Girls</span>
                                            </div>
                                        </div>
                                    </div>

                                    

                                </div>
                            </main>
                        </div>

                        <script>
                            $(document).ready(function () {
                                var table = $('#masterDirectoryTable').DataTable({
                                    responsive: true,
                                    paging: false,
                                    info: false,
                                    lengthChange: false,
                                    searching: false,
                                    columnDefs: [
                                        { responsivePriority: 1, targets: 0 },
                                        { responsivePriority: 2, targets: 1 },
                                        { orderable: false, targets: 5 }
                                    ]
                                });

                                $('#clearSearchBtn').on('click', function () {
                                    $('#searchInput').val('');
                                    $(this).hide();
                                    $('#searchForm').submit();
                                });

                                $('#searchInput').on('input', function () {
                                    if ($(this).val().length > 0) {
                                        $('#clearSearchBtn').show();
                                    } else {
                                        $('#clearSearchBtn').hide();
                                    }
                                });

                                // Ensure dropdown scroll on all devices
                                $('.excel-dropdown-menu').on('shown.bs.dropdown', function () {
                                    $(this).css('overflow-y', 'auto');
                                });
                            });
                        </script>

    </body>

</html>