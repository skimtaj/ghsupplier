<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5" />
  <title>G.H Suppliers · Portal</title>
  <!-- Font Awesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <style>
    /* ----- RESET & BASE ----- */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      background-color: #0d0d1a;
      background-image: url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?q=80&w=2070&auto=format&fit=crop');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      padding: 1.5rem;
    }

    /* Dark Overlay — deep navy with blue tint */
    body::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(10, 12, 40, 0.82);
      z-index: -1;
    }

    /* ----- MAIN CARD (Glassmorphism) — Blue accent (no hover animation) ----- */
    .login-card {
      width: 100%;
      max-width: 440px;
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(92, 91, 239, 0.2);
      border-radius: 40px;
      padding: 2.8rem 2.2rem;
      box-shadow: 0 30px 60px -10px rgba(20, 20, 60, 0.8), 0 0 0 1px rgba(92, 91, 239, 0.08) inset;
    }

    /* ----- BRANDING (shared) ----- */
    .brand-area {
      display: flex;
      flex-direction: column;
      align-items: center;
      margin-bottom: 2.2rem;
      color: #ffffff;
      transition: opacity 0.25s ease, max-height 0.3s ease;
    }

    .brand-avatar {
      width: 72px;
      height: 72px;
      border-radius: 50%;
      background: linear-gradient(145deg, #5C5BEF, #3d3cb8);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.8rem;
      font-weight: 700;
      box-shadow: 0 8px 24px rgba(92, 91, 239, 0.45);
      margin-bottom: 1rem;
      border: 2px solid rgba(92, 91, 239, 0.3);
      color: #ffffff;
    }

    .brand-area h1 {
      font-size: 1.6rem;
      font-weight: 600;
      letter-spacing: -0.5px;
      background: linear-gradient(to right, #c8c6ff, #8a89f5);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .brand-area p {
      font-size: 0.95rem;
      opacity: 0.7;
      font-weight: 300;
      margin-top: 0.2rem;
      color: #b0b0e8;
    }

    /* hide brand when forgot is active */
    .brand-area.hidden-brand {
      opacity: 0;
      max-height: 0;
      margin: 0;
      padding: 0;
      pointer-events: none;
      overflow: hidden;
      transition: opacity 0.25s ease, max-height 0.3s ease, margin 0.3s ease;
    }

    /* ----- FORM CONTAINERS (toggle) ----- */
    .login-form {
      display: flex;
      flex-direction: column;
      gap: 1.8rem;
    }

    .forgot-panel {
      display: none;
      flex-direction: column;
      gap: 1.8rem;
      animation: fadeSlide 0.3s ease;
    }

    .forgot-panel.active {
      display: flex;
    }

    .login-form.hidden {
      display: none;
    }

    @keyframes fadeSlide {
      from {
        opacity: 0;
        transform: translateY(12px);
      }

      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ----- INPUTS — with HIGHLIGHTED LABELS (blue) ----- */
    .input-group {
      position: relative;
    }

    .input-group label {
      display: block;
      font-size: 0.8rem;
      font-weight: 600;
      color: #9a99f0;
      margin-bottom: 0.5rem;
      letter-spacing: 0.6px;
      text-transform: uppercase;
      text-shadow: 0 0 14px rgba(92, 91, 239, 0.15);
      transition: color 0.3s;
    }

    .input-group label i {
      margin-right: 6px;
      color: #7a79e5;
    }

    .input-wrapper {
      position: relative;
    }

    .input-wrapper i.prefix {
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      color: rgba(92, 91, 239, 0.4);
      font-size: 1rem;
      transition: color 0.3s;
    }

    .input-wrapper input {
      width: 100%;
      padding: 0.8rem 0 0.8rem 2.2rem;
      background: transparent;
      border: none;
      border-bottom: 1.5px solid rgba(92, 91, 239, 0.2);
      font-size: 1rem;
      color: #f0f0ff;
      outline: none;
      transition: all 0.3s ease;
    }

    .input-wrapper input:focus {
      border-bottom-color: #5C5BEF;
      box-shadow: 0 2px 12px rgba(92, 91, 239, 0.08);
    }

    .input-wrapper input:focus+i.prefix,
    .input-wrapper input:focus~.toggle-pass {
      color: #5C5BEF;
    }

    .input-wrapper input::placeholder {
      color: rgba(255, 255, 255, 0.2);
      font-weight: 300;
    }

    .input-wrapper .toggle-pass {
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: rgba(92, 91, 239, 0.3);
      cursor: pointer;
      transition: color 0.3s;
      font-size: 1rem;
      padding: 4px;
    }

    .input-wrapper .toggle-pass:hover {
      color: #9a99f0;
    }

    /* ----- ACTIONS ----- */
    .form-actions {
      display: flex;
      justify-content: flex-end;
      margin-top: -0.5rem;
    }

    .forgot-btn {
      background: none;
      border: none;
      color: rgba(92, 91, 239, 0.6);
      font-size: 0.85rem;
      cursor: pointer;
      transition: color 0.3s;
      padding: 4px 0;
      font-weight: 400;
    }

    .forgot-btn:hover {
      color: #b0aff5;
      text-decoration: underline;
    }

    .btn-submit {
      width: 100%;
      padding: 1rem;
      background: linear-gradient(145deg, #5C5BEF, #3d3cb8);
      color: #ffffff;
      border: none;
      border-radius: 16px;
      font-weight: 700;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.3s ease;
      box-shadow: 0 4px 20px rgba(92, 91, 239, 0.35);
      letter-spacing: 0.5px;
    }

    .btn-submit:hover {
      background: linear-gradient(145deg, #7a79f2, #4a49c9);
      transform: scale(1.02);
      box-shadow: 0 8px 30px rgba(92, 91, 239, 0.5);
    }

    .btn-back {
      background: rgba(92, 91, 239, 0.08);
      color: #b0b0e8;
      border: 1px solid rgba(92, 91, 239, 0.15);
      padding: 1rem;
      border-radius: 16px;
      font-weight: 500;
      cursor: pointer;
      width: 100%;
      transition: all 0.3s;
      font-size: 1rem;
      backdrop-filter: blur(4px);
    }

    .btn-back:hover {
      background: rgba(92, 91, 239, 0.18);
      border-color: rgba(92, 91, 239, 0.35);
      color: #f0f0ff;
    }

    .signup-link {
      text-align: center;
      margin-top: 1.5rem;
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.45);
    }

    .signup-link a {
      color: #8a89f5;
      text-decoration: none;
      font-weight: 500;
      border-bottom: 1px solid rgba(92, 91, 239, 0.2);
    }

    .signup-link a:hover {
      border-bottom-color: #8a89f5;
      color: #c8c6ff;
    }

    /* forgot panel inner brand (mini) */
    .forgot-panel .brand-mini {
      display: flex;
      flex-direction: column;
      align-items: center;
      color: #ffffff;
      margin-bottom: 1.2rem;
    }

    .forgot-panel .brand-mini .brand-avatar {
      width: 56px;
      height: 56px;
      font-size: 1.4rem;
      margin-bottom: 0.6rem;
      background: linear-gradient(145deg, #5C5BEF, #3d3cb8);
      box-shadow: 0 8px 20px rgba(92, 91, 239, 0.35);
      color: #ffffff;
    }

    .forgot-panel .brand-mini h1 {
      font-size: 1.3rem;
      font-weight: 600;
      letter-spacing: -0.3px;
      background: linear-gradient(to right, #c8c6ff, #8a89f5);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .forgot-panel .brand-mini p {
      font-size: 0.85rem;
      opacity: 0.7;
      font-weight: 300;
      margin-top: 0.2rem;
      color: #b0b0e8;
    }

    /* ============================================== */
    /* ----- RESPONSIVE (MOBILE FIRST) ----- */
    /* ============================================== */
    @media (max-width: 600px) {
      body {
        padding: 1rem;
        align-items: flex-start;
        padding-top: 2.5rem;
      }

      .login-card {
        padding: 2rem 1.5rem;
        border-radius: 32px;
        max-width: 100%;
      }

      .brand-avatar {
        width: 60px;
        height: 60px;
        font-size: 1.4rem;
      }

      .brand-area h1 {
        font-size: 1.4rem;
      }

      .brand-area p {
        font-size: 0.85rem;
      }

      .input-group label {
        font-size: 0.75rem;
      }

      .input-wrapper input {
        font-size: 0.9rem;
        padding: 0.7rem 0 0.7rem 2rem;
      }

      .input-wrapper i.prefix {
        font-size: 0.9rem;
      }

      .btn-submit {
        padding: 0.8rem;
        font-size: 0.95rem;
        border-radius: 14px;
      }

      .btn-back {
        padding: 0.8rem;
        font-size: 0.95rem;
      }

      .forgot-btn {
        font-size: 0.8rem;
      }

      .signup-link {
        font-size: 0.85rem;
        margin-top: 1.2rem;
      }

      .login-form,
      .forgot-panel {
        gap: 1.5rem;
      }

      .forgot-panel .brand-mini .brand-avatar {
        width: 50px;
        height: 50px;
        font-size: 1.2rem;
      }

      .forgot-panel .brand-mini h1 {
        font-size: 1.2rem;
      }
    }

    @media (max-width: 400px) {
      .login-card {
        padding: 1.5rem 1rem;
      }

      .brand-area h1 {
        font-size: 1.2rem;
      }

      .input-wrapper input {
        font-size: 0.85rem;
        padding: 0.6rem 0 0.6rem 1.8rem;
      }

      .input-wrapper i.prefix {
        font-size: 0.8rem;
      }

      .btn-submit,
      .btn-back {
        font-size: 0.85rem;
        padding: 0.7rem;
      }
    }
  </style>
</head>

<body>


  <% if (messages.success) { %>
    <script>
      Swal.fire({
        toast: true,
        position: "top-end",
        icon: "success",
        title: "<%= messages.success %>",
        showConfirmButton: false,
        timer: 3000,
        timerProgressBar: true,
        background: "#ffffff",
        iconColor: "#00b894",
        color: "#333",
        customClass: {
          popup: 'custom-swal-toast'
        },
        didOpen: (toast) => {
          toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.1)';
          toast.style.borderRadius = '8px';
          toast.style.padding = '0.75rem 1.25rem';
        }
      });
    </script>
    <% } %>


      <% if (messages.error) { %>
        <script>
          Swal.fire({
            toast: true,
            position: "top-end",
            icon: "error",
            title: "<%= messages.error %>",
            showConfirmButton: false,
            timer: 3000,
            timerProgressBar: true,
            background: "#ffffff",
            iconColor: "#red",
            color: "#333",
            customClass: {
              popup: 'custom-swal-toast'
            },
            didOpen: (toast) => {
              toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.1)';
              toast.style.borderRadius = '8px';
              toast.style.padding = '0.75rem 1.25rem';
            }
          });
        </script>
        <% } %>



          <div class="login-card">

            <!-- Branding (shared) – hidden when forgot is active -->
            <div class="brand-area" id="mainBrand">
              <div class="brand-avatar">G.H</div>
              <h1>Welcome Back</h1>
              <p>Sign in to your supplier portal</p>
            </div>

            <!-- 1. LOGIN FORM -->
            <form class="login-form" id="loginForm" method="post" action="/ghsupplier/auth/login">
              <!-- Email with highlighted label -->
              <div class="input-group">
                <label for="loginEmail"><i class="fas fa-envelope" style="margin-right: 6px;"></i>Email Address</label>
                <div class="input-wrapper">
                  <input type="email" id="loginEmail" placeholder="john@ghsuppliers.com" required autocomplete="email"
                    name="email" />
                  <i class="fas fa-envelope prefix"></i>
                </div>
              </div>

              <!-- Password with highlighted label -->
              <div class="input-group">
                <label for="loginPassword"><i class="fas fa-lock" style="margin-right: 6px;"></i>Password</label>
                <div class="input-wrapper">
                  <input type="password" id="loginPassword" placeholder="••••••••" required
                    autocomplete="current-password" name="password" />
                  <i class="fas fa-lock prefix"></i>
                  <button type="button" class="toggle-pass" onclick="togglePassword('loginPassword', this)">
                    <i class="fas fa-eye"></i>
                  </button>
                </div>
              </div>

              <div class="form-actions">
                <button type="button" class="forgot-btn" id="showForgotBtn">Forgot password?</button>
              </div>

              <button type="submit" class="btn-submit">Sign In</button>


            </form>


            <form method="post" action="/forget-password" >

              <div class="forgot-panel" id="forgotPanel">
                <div class="brand-mini">
                  <div class="brand-avatar"><i class="fas fa-key"></i></div>
                  <h1>Reset Password</h1>
                  <p>We'll email you a reset link</p>
                </div>

                <div class="input-group">
                  <label for="resetEmail"><i class="fas fa-envelope" style="margin-right: 6px;"></i>Email
                    Address</label>
                  <div class="input-wrapper">
                    <input type="email" id="resetEmail" placeholder="your@email.com" required name="email" />
                    <i class="fas fa-envelope prefix"></i>
                  </div>
                </div>

                <button type="submit" class="btn-submit" id="resetBtn">Send Reset Link</button>

            </form>

            <button type="button" class="btn-back" id="cancelForgotBtn"><i class="fas fa-arrow-left"
                style="margin-right: 8px;"></i> Back to Sign In</button>
          </div>

          </div>

          <script>
            // Toggle password visibility
            function togglePassword(inputId, btn) {
              const input = document.getElementById(inputId);
              const icon = btn.querySelector('i');
              if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('fa-eye', 'fa-eye-slash');
              } else {
                input.type = 'password';
                icon.classList.replace('fa-eye-slash', 'fa-eye');
              }
            }

            document.addEventListener('DOMContentLoaded', () => {
              const loginForm = document.getElementById('loginForm');
              const forgotPanel = document.getElementById('forgotPanel');
              const showForgotBtn = document.getElementById('showForgotBtn');
              const cancelForgotBtn = document.getElementById('cancelForgotBtn');
              const mainBrand = document.getElementById('mainBrand');

              // Show Forgot Panel → hide main brand + login form
              showForgotBtn.addEventListener('click', () => {
                mainBrand.classList.add('hidden-brand');
                loginForm.classList.add('hidden');
                forgotPanel.classList.add('active');
              });

              // Back to Login → show main brand + login form, hide forgot
              cancelForgotBtn.addEventListener('click', () => {
                mainBrand.classList.remove('hidden-brand');
                forgotPanel.classList.remove('active');
                loginForm.classList.remove('hidden');
                document.getElementById('resetEmail').value = '';
              });



    
            });
          </script>
</body>

</html>