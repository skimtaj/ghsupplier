<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Online Result - Nababia Mission</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:wght@700&display=swap"
        rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', Arial, Helvetica, sans-serif;
            display: flex;
            justify-content: center;
            /* Center the form */
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            background-image: url('https://nababiamission.org/wp-content/uploads/2026/05/hostel.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            background-attachment: fixed;
            position: relative;
        }

        /* Premium Overlay with gradient */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, rgba(63, 6, 63, 0.6) 0%, rgba(240, 237, 242, 0.3) 100%);
            z-index: 0;
            backdrop-filter: blur(2px);
        }

        /* Decorative floating shapes */
        body::after {
            content: '';
            position: fixed;
            top: -50%;
            right: -20%;
            width: 600px;
            height: 600px;
            background: radial-gradient(circle, rgba(255, 215, 0, 0.05), transparent 70%);
            border-radius: 50%;
            z-index: 0;
            pointer-events: none;
        }

        .result-card {
            background: rgba(255, 255, 255, 0.15);
            /* Transparent background */
            backdrop-filter: blur(25px);
            -webkit-backdrop-filter: blur(25px);
            border-radius: 24px;
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.4), 0 0 0 1px rgba(255, 255, 255, 0.12) inset;
            max-width: 420px;
            width: 100%;
            padding: 30px 32px 24px 32px;
            position: relative;
            z-index: 1;
            margin: 0 auto;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            animation: slideIn 0.6s ease-out;
        }

        .result-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 40px 90px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.2) inset;
        }

        @keyframes slideIn {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Header with Logo */
        .header-row {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 8px;
        }

        .logo-placeholder {
            width: 60px;
            height: 60px;
            background: rgba(255, 255, 255, 0.15);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            border: 2px solid rgba(255, 255, 255, 0.2);
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            backdrop-filter: blur(10px);
        }

        .logo-placeholder:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 25px rgba(0, 0, 0, 0.3);
        }

        .logo-placeholder img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 12px;
        }

        .logo-placeholder .logo-text {
            color: #fff;
            font-size: 22px;
            font-weight: 800;
            letter-spacing: 2px;
            font-family: 'Playfair Display', serif;
        }

        .institute-name {
            flex: 1;
        }

        .institute-name .highlight {
            font-size: 35px;
            font-weight: 800;
            color: #ffffff;
            letter-spacing: -0.5px;
            font-family: 'Playfair Display', serif;
            text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
        }

        .institute-name .tagline {
            display: block;
            font-size: 10px;
            font-weight: 400;
            color: rgba(255, 255, 255, 0.7);
            letter-spacing: 0.5px;
            text-transform: uppercase;
            margin-top: 2px;
        }

        .sub-title {
            font-size: 10px;
            color: rgba(255, 255, 255, 0.65);
            margin-top: 2px;
            line-height: 1.5;
            border-bottom: 2px solid rgba(255, 255, 255, 0.1);
            padding-bottom: 12px;
            margin-bottom: 16px;
            padding-left: 74px;
            font-weight: 400;
            letter-spacing: 0.2px;
        }

        .sub-title span {
            font-weight: 600;
            color: rgba(255, 255, 255, 0.9);
        }

        /* Main Heading */
        .result-heading {
            font-size: 22px;
            font-weight: 800;
            color: #ffffff;
            text-align: center;
            letter-spacing: 3px;
            margin-bottom: 18px;
            padding-bottom: 12px;
            position: relative;
            font-family: 'Playfair Display', serif;
            text-shadow: 0 2px 20px rgba(0, 0, 0, 0.3);
        }

        .result-heading::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 60px;
            height: 3px;
            background: linear-gradient(90deg, #ffd700, #b8860b);
            border-radius: 3px;
        }

        /* Form */
        .form-group {
            margin-bottom: 16px;
        }

        .form-group label {
            display: block;
            font-size: 11px;
            font-weight: 600;
            color: rgba(255, 255, 255, 0.85);
            margin-bottom: 4px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .form-group select,
        .form-group input {
            width: 100%;
            padding: 10px 14px;
            border: 2px solid rgba(255, 255, 255, 0.2);
            border-radius: 12px;
            font-size: 14px;
            color: #1a0a2e;
            background: rgba(255, 255, 255, 0.85);
            outline: none;
            transition: all 0.3s ease;
            font-family: 'Inter', Arial, Helvetica, sans-serif;
            font-weight: 500;
            backdrop-filter: blur(10px);
        }

        .form-group select option {
            background: #fff;
            color: #1a0a2e;
        }

        .form-group select:hover,
        .form-group input:hover {
            border-color: rgba(255, 255, 255, 0.4);
            background: rgba(255, 255, 255, 0.95);
        }

        .form-group select:focus,
        .form-group input:focus {
            border-color: #ffd700;
            box-shadow: 0 0 0 4px rgba(255, 215, 0, 0.15);
            background: rgba(255, 255, 255, 0.95);
        }

        .form-group select {
            appearance: auto;
            cursor: pointer;
        }

        .form-group input::placeholder {
            color: #888;
            font-weight: 400;
            font-size: 13px;
        }

        /* Two columns for Class and Section */
        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
        }

        .form-row .form-group {
            margin-bottom: 0;
        }

        /* Gap between Section row and Roll Number */
        .form-gap {
            margin-top: 8px;
        }

        /* Buttons */
        .btn-row {
            display: flex;
            gap: 12px;
            margin-top: 10px;
        }

        .btn {
            flex: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 12px;
            font-size: 14px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            text-align: center;
            letter-spacing: 0.5px;
            font-family: 'Inter', Arial, Helvetica, sans-serif;
        }

        .btn-show {
            background: linear-gradient(135deg, #ffd700, #b8860b);
            color: #1a0a2e;
            box-shadow: 0 4px 20px rgba(255, 215, 0, 0.3);
        }

        .btn-show:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 35px rgba(255, 215, 0, 0.4);
            background: linear-gradient(135deg, #ffe44d, #c9970c);
        }

        .btn-show:active {
            transform: translateY(0px);
        }

        .btn-cancel {
            background: rgba(255, 255, 255, 0.2);
            color: #ffffff;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.15);
        }

        .btn-cancel:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.2);
        }

        .btn-cancel:active {
            transform: translateY(0px);
        }

        /* Footer */
        .footer-text {
            text-align: center;
            font-size: 10px;
            color: rgba(255, 255, 255, 0.5);
            margin-top: 18px;
            padding-top: 14px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            letter-spacing: 0.3px;
            font-weight: 400;
        }

        .footer-text strong {
            color: rgba(255, 255, 255, 0.8);
            font-weight: 700;
        }

        .footer-text .divider {
            color: rgba(255, 255, 255, 0.2);
            margin: 0 6px;
        }

        .footer-text .gold {
            color: #ffd700;
        }

        /* Decorative corner accent */
        .result-card::before {
            content: '';
            position: absolute;
            top: -2px;
            right: -2px;
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, transparent 50%, rgba(255, 215, 0, 0.08) 50%);
            border-radius: 0 24px 0 80px;
            pointer-events: none;
        }

        /* Responsive */
        @media (max-width: 768px) {
            body {
                padding: 20px;
            }

            .result-card {
                animation: slideUp 0.5s ease-out;
            }

            @keyframes slideUp {
                from {
                    opacity: 0;
                    transform: translateY(30px);
                }

                to {
                    opacity: 1;
                    transform: translateY(0);
                }
            }
        }

        @media (max-width: 500px) {
            .result-card {
                padding: 20px;
                max-width: 100%;
                border-radius: 18px;
                background: rgba(255, 255, 255, 0.12);
            }

            .header-row {
                flex-direction: column;
                align-items: center;
                text-align: center;
                gap: 10px;
            }

            .sub-title {
                padding-left: 0;
                text-align: center;
            }

            .institute-name .highlight {
                font-size: 18px;
            }

            .result-heading {
                font-size: 20px;
            }

            .form-row {
                grid-template-columns: 1fr;
                gap: 14px;
            }

            .form-row .form-group {
                margin-bottom: 0;
            }

            .btn-row {
                flex-direction: column;
            }

            .btn {
                padding: 14px 20px;
            }

            .result-card::before {
                display: none;
            }

            .form-gap {
                margin-top: 4px;
            }
        }

        @media (min-width: 769px) and (max-width: 1024px) {
            .result-card {
                max-width: 380px;
                padding: 24px 26px 20px 26px;
            }
        }
    </style>
</head>

<body>


    <% if (messages.success) { %>
        <script>
            Swal.fire({
                toast: true,
                position: "top-end",
                icon: "success",
                title: "<%= messages.success %>",
                showConfirmButton: false,
                timer: 3000,
                timerProgressBar: true,
                background: "#ffffff",
                iconColor: "#00b894",
                color: "#333",
                customClass: {
                    popup: 'custom-swal-toast'
                },
                didOpen: (toast) => {
                    toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.1)';
                    toast.style.borderRadius = '8px';
                    toast.style.padding = '0.75rem 1.25rem';
                }
            });
        </script>
        <% } %>



            <% if (messages.error) { %>
                <script>
                    Swal.fire({
                        toast: true,
                        position: "top-end",
                        icon: "error",
                        title: "<%= messages.error %>",
                        showConfirmButton: false,
                        timer: 3000,
                        timerProgressBar: true,
                        background: "#ffffff",
                        iconColor: "#red",
                        color: "#333",
                        customClass: {
                            popup: 'custom-swal-toast'
                        },
                        didOpen: (toast) => {
                            toast.style.boxShadow = '0 4px 12px rgba(0,0,0,0.1)';
                            toast.style.borderRadius = '8px';
                            toast.style.padding = '0.75rem 1.25rem';
                        }
                    });
                </script>
                <% } %>


                    <div class="result-card">

                        <!-- Header with Logo -->
                        <div class="header-row">
                            <!-- Logo Image -->
                            <div class="logo-placeholder">
                                <img src="https://nababiamission.org/wp-content/uploads/2026/05/unnamed-file.jpg"
                                    alt="Nababia Mission Logo" />
                            </div>

                            <div class="institute-name">
                                <span class="highlight">Nababia Mission</span>
                                <span class="tagline">An Educational &amp; Welfare Trust</span>
                            </div>
                        </div>

                        <div class="sub-title">
                            <span>Mainan, Khanakul, Hooghly</span> &bull; 712406
                        </div>

                        <!-- Online Result Heading -->
                        <div class="result-heading">Class Test Result</div>

                        <!-- Form -->
                        <form id="resultForm" action="/nababiamission/results/class-test-result" method="post">

                            <!-- Class + Section in one row -->
                            <div class="form-row">
                                <!-- Class (Dropdown) -->
                                <div class="form-group">
                                    <label for="classSelect">Class</label>
                                    <select id="classSelect" name="current_class" required>
                                        <option value="">— Select —</option>
                                        <option value="Nursery">Nursery</option>
                                        <option value="I">I</option>
                                        <option value="II">II</option>
                                        <option value="III">III</option>
                                        <option value="IV">IV</option>
                                        <option value="V">V</option>
                                        <option value="VI">VI</option>
                                        <option value="VII">VII</option>
                                        <option value="VIII">VIII</option>
                                        <option value="IX">IX</option>
                                        <option value="X">X</option>
                                        <option value="XI (Science)">XI (Science)</option>
                                        <option value="XI (Arts)">XI (Arts)</option>
                                        <option value="XII (Science)">XII (Science)</option>
                                        <option value="XII (Arts)">XII (Arts) </option>
                                    </select>
                                </div>

                                <!-- Section (Dropdown) -->
                                <div class="form-group">
                                    <label for="sectionSelect">Section</label>
                                    <select id="sectionSelect" name="section" required>
                                        <option value="">— Select —</option>
                                        <option value="Boys">Boys</option>
                                        <option value="Girls">Girls</option>
                                    </select>
                                </div>
                            </div>

                            <!-- Gap between Section row and Roll Number -->
                            <div class="form-gap"></div>

                            <!-- Roll Number -->
                            <div class="form-group">
                                <label for="rollNo">Roll Number</label>
                                <input type="number" id="rollNo" name="roll_no" placeholder="Exaple - 01" />
                            </div>

                            <!-- Buttons -->
                            <div class="btn-row">
                                <button type="submit" class="btn btn-show">Show Result</button>
                                <button type="reset" class="btn btn-cancel">Cancel</button>
                            </div>

                        </form>

                        <!-- Footer -->
                        <div class="footer-text">
                            Designed &amp; Developed By: <strong>Nababia Mission</strong>
                            <span class="divider">|</span>
                            Copyright &copy; 2026. <span class="gold">✦</span> All Rights Reserved.
                        </div>

                    </div>

</body>

<script>

    document.getElementById('resultForm').addEventListener('submit', () => {

        const allInputFields = document.getElementById('resultForm').querySelectorAll('input[type="number"], input[type="text"], textarea')

        allInputFields.forEach((inp) => {

            inp.value = inp.value.trim();

        })

    })

</script>

</html>