<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes, viewport-fit=cover" />
  <title>NM · Student Result 2026</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.0/dist/css/bootstrap.min.css" />
  <style>
    /* ----- RESET & VARIABLES ----- */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    body {
      background: #f0edf2;
      min-height: 100vh;
      color: #1e1a2b;
      -webkit-font-smoothing: antialiased;
      padding: 1.5rem;
      display: flex;
      justify-content: center;
      align-items: center;
      position: relative;
      overflow-x: hidden;
    }

    :root {
      --primary: #4F0853;
      --primary-light: #6d1a72;
      --primary-dark: #2e0431;
      --primary-gradient: linear-gradient(135deg, #6C1B7A 0%, #4F0853 40%, #2D1B69 100%);
      --white: #ffffff;
      --shadow: 0 2px 12px rgba(79, 8, 83, 0.08);
      --shadow-md: 0 4px 20px rgba(79, 8, 83, 0.10);
      --shadow-lg: 0 8px 32px rgba(79, 8, 83, 0.15);
      --border: #d6cedb;
      --radius: 16px;
    }

    /* ===== CONFETTI CANVAS ===== */
    #confettiCanvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      z-index: 9999;
    }

    /* ----- MAIN WRAPPER ----- */
    .main-wrapper {
      max-width: 960px;
      width: 100%;
      display: grid;
      gap: 20px;
      position: relative;
      z-index: 1;
    }

    /* ----- HEADER ----- */
    .professional-header {
      background: var(--primary-gradient);
      border-radius: var(--radius);
      padding: 1rem 1.8rem;
      color: white;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px 24px;
      position: relative;
      overflow: hidden;
      box-shadow: var(--shadow-lg);
      opacity: 0;
      animation: fadeInUp 0.6s ease forwards 0.3s;
    }

    .professional-header::before {
      content: '';
      position: absolute;
      top: -50%;
      right: -10%;
      width: 300px;
      height: 300px;
      background: radial-gradient(circle, rgba(217, 176, 221, 0.10), transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .professional-header::after {
      content: '';
      position: absolute;
      bottom: -40%;
      left: -5%;
      width: 200px;
      height: 200px;
      background: radial-gradient(circle, rgba(100, 200, 255, 0.06), transparent 70%);
      border-radius: 50%;
      pointer-events: none;
    }

    .header-left {
      display: flex;
      align-items: center;
      gap: 16px;
      position: relative;
      z-index: 1;
      flex-wrap: wrap;
    }

    .header-logo-img {
      height: 54px;
      width: auto;
      max-width: 64px;
      object-fit: contain;
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.10);
      padding: 4px 8px;
      border: 1.5px solid rgba(255, 255, 255, 0.20);
      backdrop-filter: blur(4px);
      transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
      display: block;
    }

    .header-logo-img:hover {
      transform: scale(1.04);
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
      border-color: #d9b0dd;
    }

    .header-title {
      display: flex;
      flex-direction: column;
      line-height: 1.2;
    }

    .header-title h1 {
      font-size: 1.5rem;
      font-weight: 800;
      letter-spacing: -0.4px;
      margin: 0;
      color: white;
      text-shadow: 0 2px 4px rgba(0, 0, 0, 0.08);
    }

    .header-title .subhead {
      font-size: 0.75rem;
      opacity: 0.85;
      margin: 0;
      letter-spacing: 0.4px;
      font-weight: 400;
      display: flex;
      align-items: center;
      gap: 6px;
      flex-wrap: wrap;
    }

    .header-actions {
      display: flex;
      align-items: center;
      gap: 12px;
      position: relative;
      z-index: 1;
      flex-wrap: wrap;
    }

    .btn-back {
      background: rgba(255, 255, 255, 0.12);
      border: 1.5px solid rgba(255, 255, 255, 0.25);
      border-radius: 40px;
      padding: 0.45rem 1.4rem;
      font-weight: 600;
      font-size: 0.8rem;
      color: white;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      cursor: pointer;
      transition: all 0.25s ease;
      backdrop-filter: blur(4px);
      text-decoration: none;
      letter-spacing: 0.2px;
    }

    .btn-back:hover {
      background: rgba(255, 255, 255, 0.25);
      border-color: #d9b0dd;
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(0, 0, 0, 0.18);
      color: white;
      text-decoration: none;
    }

    .btn-back i {
      font-size: 0.85rem;
    }

    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ----- STUDENT FORM (read-only) ----- */
    .student-form-card {
      background: var(--white);
      border-radius: var(--radius);
      padding: 1.2rem 1.5rem;
      box-shadow: var(--shadow-md);
      border: 1px solid rgba(79, 8, 83, 0.06);
      opacity: 0;
      animation: fadeInUp 0.6s ease forwards 0.5s;
    }

    .student-form-grid {
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      gap: 12px 16px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .form-group label {
      font-size: 0.6rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #7a6e7f;
    }

    .form-group input {
      padding: 0.5rem 0.8rem;
      border: 1.5px solid #d6cedb;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--primary-dark);
      background: #fcfafd;
      transition: border 0.2s, box-shadow 0.2s;
      width: 100%;
    }

    .form-group input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(79, 8, 83, 0.08);
      outline: none;
      background: white;
    }

    .form-group input::placeholder {
      color: #b0a5b5;
      font-weight: 300;
    }

    /* ----- TABLE : FULL & OBTAINED SIDE BY SIDE (STATIC) ----- */
    .table-container {
      background: var(--white);
      border-radius: var(--radius);
      box-shadow: var(--shadow-md);
      overflow: hidden;
      transition: box-shadow 0.2s;
      opacity: 0;
      animation: fadeInUp 0.6s ease forwards 0.7s;
    }

    .table-container:hover {
      box-shadow: var(--shadow-lg);
    }

    .table-header {
      padding: 1rem 1.5rem;
      background: #ffffff;
      border-bottom: 1px solid rgba(79, 8, 83, 0.06);
    }

    .table-title h3 {
      font-weight: 700;
      margin: 0;
      font-size: 1.1rem;
      color: var(--primary-dark);
      letter-spacing: -0.3px;
    }

    .table-wrapper {
      padding: 0 1.2rem 0.5rem 1.2rem;
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    table thead th {
      padding: 12px 10px;
      background: #f8f4fa;
      font-weight: 700;
      font-size: 0.75rem;
      color: var(--primary-dark);
      border-bottom: 2.5px solid var(--primary);
      text-align: left;
      text-transform: uppercase;
      letter-spacing: 0.3px;
    }

    /* center numeric columns */
    table thead th:nth-child(2),
    table thead th:nth-child(3),
    table tbody td:nth-child(2),
    table tbody td:nth-child(3) {
      text-align: center;
    }

    table tbody td {
      padding: 10px 10px;
      font-size: 0.9rem;
      vertical-align: middle;
      border-bottom: 1px solid #edeaf0;
    }

    table tbody tr:hover {
      background: #faf7fc;
    }

    table tbody tr:last-child td {
      border-bottom: none;
    }

    /* ----- SUMMARY BLOCK (outside table, static, perfectly aligned) ----- */
    .summary-block {
      background: #f8f4fa;
      border-radius: 0 0 var(--radius) var(--radius);
      padding: 1rem 1.5rem 1.5rem 1.5rem;
      margin: 0 1.2rem 1.2rem 1.2rem;
      border-top: 2.5px solid var(--primary);
    }

    .summary-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.6rem 2rem;
    }

    .summary-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 0.4rem 0;
      border-bottom: 1px dashed rgba(79, 8, 83, 0.10);
    }

    .summary-item:last-child {
      border-bottom: none;
    }

    .summary-label {
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--primary-dark);
    }

    .summary-value {
      font-weight: 700;
      font-size: 0.95rem;
    }

    .summary-value.highlight {
      color: #1a7a3a;
    }

    /* ----- FEEDBACK (now includes student fields) ----- */
    .feedback-card {
      background: var(--white);
      border-radius: var(--radius);
      padding: 1.2rem 1.5rem;
      box-shadow: var(--shadow-md);
      border: 1px solid rgba(79, 8, 83, 0.06);
      opacity: 0;
      animation: fadeInUp 0.6s ease forwards 0.9s;
    }

    .feedback-inner-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px 20px;
      margin-bottom: 18px;
      border-bottom: 1px solid #edeaf0;
      padding-bottom: 16px;
    }

    .feedback-inner-grid .form-group {
      margin-bottom: 0;
    }

    .feedback-inner-grid .form-group label {
      font-size: 0.6rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      color: #7a6e7f;
    }

    .feedback-inner-grid .form-group input {
      padding: 0.5rem 0.8rem;
      border: 1.5px solid #d6cedb;
      border-radius: 10px;
      font-size: 0.85rem;
      font-weight: 600;
      color: var(--primary-dark);
      background: #fcfafd;
      width: 100%;
      transition: border 0.2s, box-shadow 0.2s;
    }

    .feedback-inner-grid .form-group input:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(79, 8, 83, 0.08);
      outline: none;
      background: white;
    }

    .feedback-row {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-start;
      gap: 12px;
    }

    .feedback-label {
      font-weight: 700;
      font-size: 0.85rem;
      color: var(--primary-dark);
      white-space: nowrap;
      padding-top: 0.3rem;
    }

    .feedback-input-group {
      flex: 1;
      min-width: 180px;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .feedback-input-group textarea {
      width: 100%;
      padding: 0.8rem 1.2rem;
      border: 1.5px solid #d6cedb;
      border-radius: 16px;
      font-size: 0.85rem;
      transition: border 0.2s, box-shadow 0.2s;
      background: #fcfafd;
      resize: vertical;
      min-height: 70px;
      font-family: 'Inter', sans-serif;
    }

    .feedback-input-group textarea:focus {
      border-color: var(--primary);
      box-shadow: 0 0 0 4px rgba(79, 8, 83, 0.08);
      outline: none;
      background: white;
    }

    .feedback-input-group textarea::placeholder {
      color: #b0a5b5;
      font-weight: 300;
    }

    .feedback-actions {
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }

    .btn-feedback {
      background: var(--primary-gradient);
      border: none;
      border-radius: 40px;
      padding: 0.6rem 2rem;
      font-weight: 700;
      font-size: 0.85rem;
      color: white;
      cursor: pointer;
      transition: all 0.2s;
      box-shadow: 0 2px 10px rgba(79, 8, 83, 0.25);
      white-space: nowrap;
    }

    .btn-feedback:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 24px rgba(79, 8, 83, 0.35);
    }

    /* ----- PDF BUTTON ----- */
    .pdf-section {
      display: flex;
      justify-content: center;
      padding: 0.5rem 0;
      opacity: 0;
      animation: fadeInUp 0.6s ease forwards 1.1s;
    }

    .btn-pdf-bottom {
      background: #ffffff;
      border: 2.5px solid #4F0853;
      border-radius: 40px;
      padding: 0.7rem 2.8rem;
      font-weight: 700;
      font-size: 0.9rem;
      color: #2e0431;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: 0 2px 10px rgba(79, 8, 83, 0.08);
    }

    .btn-pdf-bottom:hover {
      background: #f5f0f7;
      border-color: #6d1a72;
      transform: translateY(-3px);
      box-shadow: 0 8px 28px rgba(79, 8, 83, 0.18);
    }

    .btn-pdf-bottom i {
      font-size: 1.1rem;
      color: #4F0853;
    }

    .btn-pdf-bottom:hover i {
      color: #6d1a72;
    }

    /* ----- RESPONSIVE ----- */
    @media (max-width: 575.98px) {
      body { padding: 0.8rem; }
      .professional-header { padding: 0.8rem 1rem; flex-direction: column; align-items: stretch; gap: 12px; }
      .header-left { flex-direction: row; align-items: center; gap: 12px; flex-wrap: wrap; justify-content: space-between; }
      .header-logo-img { height: 44px; max-width: 50px; }
      .header-title h1 { font-size: 1.15rem; }
      .header-title .subhead { font-size: 0.65rem; }
      .btn-back { padding: 0.3rem 1rem; font-size: 0.7rem; align-self: flex-start; }
      .student-form-card { padding: 0.8rem 1rem; }
      .student-form-grid { grid-template-columns: 1fr 1fr; gap: 8px 12px; }
      .form-group label { font-size: 0.55rem; }
      .form-group input { font-size: 0.8rem; padding: 0.4rem 0.7rem; }
      .table-header { padding: 0.7rem 1rem; }
      .table-title h3 { font-size: 1rem; }
      .table-wrapper { padding: 0 0.6rem 0.3rem 0.6rem; }
      table thead th { padding: 10px 8px; font-size: 0.65rem; }
      table tbody td { padding: 10px 8px; font-size: 0.8rem; }
      .summary-block { padding: 0.8rem 1rem; margin: 0 0.6rem 0.8rem 0.6rem; }
      .summary-grid { grid-template-columns: 1fr; gap: 0.4rem; }
      .feedback-card { padding: 0.8rem 1rem; }
      .feedback-inner-grid { grid-template-columns: 1fr 1fr; gap: 8px 12px; }
      .feedback-row { flex-direction: column; align-items: stretch; gap: 10px; }
      .feedback-label { font-size: 0.8rem; padding-top: 0; }
      .feedback-input-group textarea { font-size: 0.8rem; padding: 0.6rem 1rem; min-height: 60px; }
      .feedback-actions { width: 100%; }
      .btn-feedback { width: 100%; justify-content: center; padding: 0.5rem 1rem; font-size: 0.8rem; }
      .btn-pdf-bottom { width: 100%; justify-content: center; padding: 0.6rem 1.2rem; font-size: 0.8rem; border-width: 2px; }
    }

    @media (min-width: 576px) and (max-width: 767.98px) {
      .professional-header { padding: 1rem 1.2rem; }
      .header-logo-img { height: 48px; }
      .header-title h1 { font-size: 1.3rem; }
      .student-form-card { padding: 1rem 1.2rem; }
      .student-form-grid { grid-template-columns: 1fr 1fr 1fr; gap: 10px 14px; }
      .feedback-inner-grid { grid-template-columns: 1fr 1fr; }
      .table-header { padding: 0.8rem 1.2rem; }
      .table-wrapper { padding: 0 1rem 0.3rem 1rem; }
      .summary-block { padding: 0.8rem 1.2rem; margin: 0 1rem 1rem 1rem; }
      .summary-grid { grid-template-columns: 1fr 1fr; }
      .feedback-card { padding: 1rem 1.2rem; }
    }

    @media (min-width: 768px) and (max-width: 991.98px) {
      .student-form-grid { grid-template-columns: 1fr 1fr 1fr; }
      .feedback-inner-grid { grid-template-columns: 1fr 1fr; }
    }

    ::-webkit-scrollbar { width: 4px; height: 4px; }
    ::-webkit-scrollbar-thumb { background: var(--primary); border-radius: 0; }

    @media print {
      .btn-back, .btn-feedback, .btn-pdf-bottom, #confettiCanvas { display: none !important; }
      .professional-header { background: #4F0853 !important; -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; }
      body { padding: 0.5rem; background: white; }
      .form-group input { border: none !important; background: transparent !important; padding: 0.2rem 0 !important; font-weight: 700; }
    }
  </style>
</head>
<body>

  <!-- ===== CONFETTI CANVAS ===== -->
  <canvas id="confettiCanvas"></canvas>

  <div class="main-wrapper" id="resultContent">

    <!-- ===== HEADER ===== -->
    <header class="professional-header">
      <div class="header-left">
        <img src="https://blogger.googleusercontent.com/img/b/R29vZ2xl/AVvXsEiZnCqhXyWuJB-G3UJAXRtO-v3qB8NITxfbJjJeLZMvTbRxEz9TIA4IfL2LHMMTlQzzxVxoHcbumXEoQap4xWfqAwqI-m58Epksx8cgVmnVNYid6sXXdDIDxxKKvZdVre5XmUM92HsfqFcj9ba9dGjez3aYSDBl5JD9iwHSfX9DZlRdjkU6gRy8NQeXhH7c/s801/WhatsApp%20Image%202026-02-08%20at%208.19.48%20PM.jpeg" alt="Nababi Mission Logo" class="header-logo-img" />
        <div class="header-title">
          <h1>Student Result 2026</h1>
          <div class="subhead"><span>Nababia Mission</span></div>
        </div>
      </div>
      <div class="header-actions">
        <a href="/nababiamission/results/class-test-result" class="btn-back" id="backButton"><i class="fas fa-arrow-left"></i> Back</a>
      </div>
    </header>

    <!-- ===== GUARDIAN FEEDBACK (includes student name, class, section, roll) ===== -->
    <form id="feedbackForm" class="feedback-card" method="post" action="/nababiamission/student-result/guardian-feedback">
      <!-- student fields inside feedback form -->
      <div class="feedback-inner-grid">
        <div class="form-group">
          <label for="fbStudentName">Student Name</label>
          <input type="text" id="fbStudentName" value="<%= studentResultSourse.student_name %>" readonly name="student_name" />
        </div>
        <div class="form-group">
          <label for="fbClass">Class</label>
          <input type="text" id="fbClass" value="<%= studentResultSourse.current_class %>" readonly name="current_class" />
        </div>
        <div class="form-group">
          <label for="fbRoll">Roll</label>
          <input type="text" id="fbRoll" value="<%= studentResultSourse.roll_no %>" readonly name="roll_no" />
        </div>
        <div class="form-group">
          <label for="fbSection">Section</label>
          <input type="text" id="fbSection" value="<%= studentResultSourse.section %>" readonly name="section" />
        </div>
      </div>

      <div class="feedback-row">
        <div class="feedback-label">Guardian Feedback</div>
        <div class="feedback-input-group">
          <textarea id="feedbackInput" placeholder="Write your feedback or suggestion here…" name="message"></textarea>
          <div class="feedback-actions">
            <button type="submit" class="btn-feedback" id="submitFeedbackBtn">Send Feedback</button>
          </div>
        </div>
      </div>
    </form>

    <!-- ===== MARKSHEET TABLE : FULL & OBTAINED (STATIC) ===== -->
    <div class="table-container">
      <div class="table-header">
        <div class="table-title">
          <h3><i class="fas fa-clipboard-list" style="color:var(--primary);margin-right:8px;"></i> Marksheet Details</h3>
        </div>
      </div>
      <div class="table-wrapper">
        <table>
          <thead>
            <tr><th>Subject</th><th>Full</th><th>Obtained</th></tr>
          </thead>
          <tbody>
            <% if (studentResultSourse.result && studentResultSourse.result.length > 0) { %>
              <% studentResultSourse.result.forEach(function(r) { %>
                <tr><td><%= r.subject %></td><td><%= r.fm %></td><td><%= r.om %></td></tr>
              <% }); %>
            <% } else { %>
              <tr><td colspan="3" style="text-align:center;color:#999;padding:20px;">No results found</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <!-- ===== SUMMARY BLOCK ===== -->
      <div class="summary-block">
        <div class="summary-grid">
          <div class="summary-item"><span class="summary-label">Total Full Marks</span><span class="summary-value"><%= studentResultSourse.total_fm %></span></div>
          <div class="summary-item"><span class="summary-label">Total Obtained</span><span class="summary-value highlight"><%= studentResultSourse.total_om %></span></div>
          <div class="summary-item"><span class="summary-label">Performance Status</span><span class="summary-value highlight"><%= studentResultSourse.result_status %> (<%= studentResultSourse.result_percentage %>%)</span></div>
        </div>
      </div>
    </div>

    

    <div class="pdf-section">
      <button onclick="window.location.href='/nababiamission/download-result/<%=studentResultSourse._id%>'" class="btn-pdf-bottom" id="pdfDownloadBtn"><i class="fas fa-file-pdf"></i> Download PDF</button>
    </div>
  </div>

  <script>
    // =============================================
    // CONFETTI ANIMATION (ONCE ON LOAD - 4 seconds)
    // =============================================
    (function () {
      const canvas = document.getElementById('confettiCanvas');
      const ctx = canvas.getContext('2d');
      let width, height;
      let particles = [];
      let animationId = null;
      let isRunning = true;
      const colors = ['#ff6b6b', '#ffd93d', '#6bcb77', '#4d96ff', '#ff6bcb', '#ff9f43', '#a29bfe', '#fd79a8', '#00cec9', '#fdcb6e', '#e17055', '#74b9ff'];

      function resize() {
        width = canvas.width = window.innerWidth;
        height = canvas.height = window.innerHeight;
      }

      class Particle {
        constructor() { this.reset(); }
        reset() {
          this.x = Math.random() * width;
          this.y = Math.random() * height - height;
          this.size = Math.random() * 8 + 3;
          this.color = colors[Math.floor(Math.random() * colors.length)];
          this.rotation = Math.random() * 360;
          this.rotationSpeed = (Math.random() - 0.5) * 6;
          this.speedY = Math.random() * 4 + 2;
          this.speedX = (Math.random() - 0.5) * 2;
          this.wobble = Math.random() * 0.04;
          this.wobbleOffset = Math.random() * 100;
          this.shape = Math.floor(Math.random() * 3);
          this.opacity = Math.random() * 0.6 + 0.4;
        }
        update() {
          this.y += this.speedY;
          this.x += this.speedX + Math.sin(this.y * this.wobble + this.wobbleOffset) * 0.5;
          this.rotation += this.rotationSpeed;
          if (this.y > height + 20) { this.reset(); this.y = -20; }
          if (this.x > width + 20) this.x = -20;
          if (this.x < -20) this.x = width + 20;
        }
        draw() {
          ctx.save();
          ctx.translate(this.x, this.y);
          ctx.rotate((this.rotation * Math.PI) / 180);
          ctx.globalAlpha = this.opacity;
          ctx.fillStyle = this.color;
          if (this.shape === 0) ctx.fillRect(-this.size/2, -this.size/2, this.size, this.size);
          else if (this.shape === 1) { ctx.beginPath(); ctx.arc(0, 0, this.size/2, 0, Math.PI*2); ctx.fill(); }
          else { ctx.beginPath(); ctx.moveTo(0, -this.size/2); ctx.lineTo(-this.size/2, this.size/2); ctx.lineTo(this.size/2, this.size/2); ctx.closePath(); ctx.fill(); }
          ctx.restore();
        }
      }

      function initConfetti(count = 220) {
        particles = [];
        for (let i = 0; i < count; i++) {
          const p = new Particle();
          p.y = Math.random() * height;
          particles.push(p);
        }
      }

      function animateConfetti() {
        if (!isRunning) return;
        ctx.clearRect(0, 0, width, height);
        for (const p of particles) { p.update(); p.draw(); }
        animationId = requestAnimationFrame(animateConfetti);
      }

      function stopConfetti() {
        isRunning = false;
        if (animationId) { cancelAnimationFrame(animationId); animationId = null; }
        ctx.clearRect(0, 0, width, height);
        canvas.style.display = 'none';
      }

      window.addEventListener('resize', resize);

      setTimeout(() => {
        resize();
        initConfetti(220);
        animateConfetti();
      }, 300);

      setTimeout(() => { stopConfetti(); }, 4000);
    })();
  </script>

</body>
</html>