<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport"
        content="width=device-width, initial-scale=1.0, maximum-scale=5.0, user-scalable=yes, viewport-fit=cover" />
    <title>404 - Page Not Found</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
        }

        body {
            background: #f4f0f5;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #1e1a2b;
            padding: 20px;
        }

        :root {
            --primary: #4F0853;
            --primary-light: #6d1a72;
            --primary-dark: #2e0431;
        }

        .error-container {
            text-align: center;
            animation: fadeIn 0.5s ease forwards;
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .error-code {
            font-size: 8rem;
            font-weight: 900;
            color: var(--primary);
            line-height: 1;
            letter-spacing: -5px;
            margin-bottom: 0.3rem;
        }

        .error-icon {
            font-size: 3rem;
            color: var(--primary);
            opacity: 0.3;
            margin-bottom: 0.3rem;
            display: block;
        }

        .error-title {
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--primary-dark);
            margin-bottom: 0.5rem;
        }

        .error-message {
            font-size: 1rem;
            color: #6b5f6f;
            margin-bottom: 2.2rem;
            line-height: 1.6;
        }

        .btn-back {
            background: var(--primary);
            border: none;
            border-radius: 0;
            padding: 0.8rem 2.5rem;
            font-size: 0.9rem;
            font-weight: 700;
            color: white;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            transition: all 0.2s;
            cursor: pointer;
            text-decoration: none;
            box-shadow: 0 2px 8px rgba(79, 8, 83, 0.25);
            letter-spacing: 0.3px;
        }

        .btn-back:hover {
            background: var(--primary-light);
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(79, 8, 83, 0.35);
            text-decoration: none;
            color: white;
        }

        .btn-back i {
            font-size: 0.9rem;
        }

        /* Responsive */
        @media (max-width:575.98px) {
            body {
                padding: 12px;
            }

            .error-code {
                font-size: 5rem;
                letter-spacing: -3px;
            }

            .error-title {
                font-size: 1.3rem;
            }

            .error-message {
                font-size: 0.9rem;
                margin-bottom: 1.8rem;
            }

            .error-icon {
                font-size: 2.2rem;
            }

            .btn-back {
                padding: 0.6rem 1.8rem;
                font-size: 0.8rem;
                width: 100%;
                justify-content: center;
            }
        }

        @media (min-width:576px) and (max-width:767.98px) {
            .error-code {
                font-size: 6rem;
            }
        }

        @media (max-width:350px) {
            .error-code {
                font-size: 4rem;
            }

            .error-title {
                font-size: 1.1rem;
            }

            .btn-back {
                font-size: 0.75rem;
                padding: 0.5rem 1.2rem;
            }
        }
    </style>
</head>

<body>

    <div class="error-container">
        <span class="error-icon">
            <i class="fas fa-exclamation-triangle"></i>
        </span>

        <div class="error-code">404</div>

        <h1 class="error-title">Page Not Found</h1>

        <p class="error-message">
            The page you're looking for doesn't exist or has been moved.
        </p>

        <a href="javascript:history.back()" class="btn-back">
            <i class="fas fa-arrow-left"></i> Go Back
        </a>
    </div>

</body>

</html>