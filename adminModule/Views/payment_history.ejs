<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Payment History · G.H Suppliers</title>
    <!-- DataTables + jQuery -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.dataTables.min.css" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.4.1/dist/css/bootstrap.min.css"
        integrity="sha384-Vkoo8x4CGsO3+Hhxv8T/Q5PaXtkKtu6ug5TOeNV6gBiFeWPGFN9MuhOf23Q9Ifjh" crossorigin="anonymous">
    <style>
        /* ----- RESET & BASE ----- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }

        body {
            background: #f4f7fc;
            color: #0b1a2b;
            padding: 2rem 1.8rem;
            min-height: 100vh;
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
        }

        /* header – clean */
        .page-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            margin-bottom: 2rem;
        }

        .page-header h1 {
            font-weight: 700;
            font-size: 1.8rem;
            color: #07445a;
            letter-spacing: -0.5px;
        }

        .page-header .subhead {
            color: #2f657c;
            font-size: 0.9rem;
            background: #e8f0f5;
            padding: 0.3rem 1.2rem;
            border-radius: 30px;
        }

        /* back button */
        .back-btn {
            background: #eaf0f5;
            border: none;
            border-radius: 40px;
            padding: 0.5rem 1.4rem;
            font-weight: 600;
            font-size: 0.85rem;
            color: #07445a;
            display: inline-flex;
            align-items: center;
            gap: 0.5rem;
            cursor: pointer;
            transition: 0.15s;
            box-shadow: 0 2px 6px rgba(0, 0, 0, 0.02);
            text-decoration: none;
        }

        .back-btn i {
            font-size: 0.9rem;
        }

        .back-btn:hover {
            background: #d5e3ee;
            color: #023047;
            box-shadow: 0 4px 10px rgba(7, 68, 90, 0.08);
        }

        /* cardless datatable wrapper */
        .table-wrapper {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 8px 30px rgba(0, 0, 0, 0.05);
            padding: 1.2rem 0.5rem 0.5rem 0.5rem;
            overflow: hidden;
        }

        /* datatable override */
        table.dataTable {
            width: 100% !important;
            border-collapse: collapse;
        }

        table.dataTable thead th {
            background: #eaf0f5;
            color: #07445a;
            font-weight: 700;
            font-size: 0.85rem;
            padding: 16px 14px;
            border-bottom: 2px solid #0f6e8c;
            white-space: nowrap;
        }

        table.dataTable tbody td {
            padding: 14px 14px;
            font-size: 0.85rem;
            border-bottom: 1px solid #e2e9f0;
            vertical-align: middle;
        }

        table.dataTable tbody tr:hover {
            background: #f8faff;
        }

        /* pagination & info */
        .dataTables_wrapper .dataTables_paginate {
            padding-top: 0.5rem;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button {
            border: 1px solid #d0dce6;
            background: #fff;
            color: #07445a !important;
            border-radius: 30px;
            padding: 0.3rem 1rem;
            margin: 0 3px;
            font-weight: 500;
            font-size: 0.8rem;
            transition: 0.15s;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
            background: #eaf0f5;
            border-color: #0f6e8c;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: #0f6e8c;
            color: #fff !important;
            border-color: #0f6e8c;
        }

        .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
            opacity: 0.4;
            cursor: default;
        }

        .dataTables_wrapper .dataTables_info {
            color: #2f5468;
            font-size: 0.8rem;
            padding-top: 0.8rem;
        }

        .dataTables_wrapper .dataTables_length {
            margin-bottom: 0.5rem;
        }

        .dataTables_wrapper .dataTables_length label {
            color: #07445a;
            font-weight: 500;
            font-size: 0.8rem;
        }

        .dataTables_wrapper .dataTables_length select {
            border: 1px solid #c6d5e0;
            border-radius: 30px;
            padding: 0.2rem 1.2rem 0.2rem 0.8rem;
            background: #fff;
            font-size: 0.8rem;
            color: #07445a;
        }

        .dataTables_wrapper .dataTables_filter {
            margin-bottom: 0.5rem;
        }

        .dataTables_wrapper .dataTables_filter label {
            color: #07445a;
            font-weight: 500;
            font-size: 0.8rem;
        }

        .dataTables_wrapper .dataTables_filter input {
            border: 1px solid #c6d5e0;
            border-radius: 30px;
            padding: 0.3rem 1rem 0.3rem 1.8rem;
            background: white url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="%2307445a" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>') no-repeat 10px center;
            background-size: 14px;
            font-size: 0.8rem;
            min-width: 200px;
            transition: 0.15s;
        }

        .dataTables_wrapper .dataTables_filter input:focus {
            border-color: #0f6e8c;
            outline: none;
            box-shadow: 0 0 0 3px rgba(15, 110, 140, 0.1);
        }

        .dataTables_wrapper .dataTables_filter input::placeholder {
            color: #8faec0;
        }

        /* responsive */
        @media (max-width: 650px) {
            body {
                padding: 1rem 0.5rem;
            }

            .page-header h1 {
                font-size: 1.4rem;
            }

            .table-wrapper {
                padding: 0.5rem 0;
            }

            table.dataTable thead th,
            table.dataTable tbody td {
                padding: 10px 6px;
                font-size: 0.7rem;
            }

            .dataTables_wrapper .dataTables_filter input {
                min-width: 120px;
            }

            .back-btn {
                padding: 0.3rem 1rem;
                font-size: 0.75rem;
            }
        }
    </style>
</head>

<body>

    <div class="container">

        <!-- HEADER with back button -->
        <div class="page-header">
            <div style="display: flex; align-items: center; gap: 1.2rem;">
                <!-- Back button -->
                <button class="back-btn" onclick="window.history.back();">
                    <i class="fas fa-arrow-left"></i> Back
                </button>
                <h1>Payment History</h1>
            </div>
        </div>

        <!-- STATIC DATATABLE – status column removed -->
        <div class="table-wrapper">
            <table id="paymentTable" class="display responsive nowrap" style="width:100%">
                <thead>
                    <tr>
                        <th>Sl NO</th>
                        <th>Date</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>

                    <% billingSourse.dueArray.forEach((dp, index)=>{ %>


                        <tr>
                            <td>
                                <%= index+1%>
                            </td>
                            <td>
                                <%=dp.payment_date%>
                            </td>

                            <td>
                                <%=dp.payment_amount%>
                            </td>

                            <td>
                                <%=dp.payment_method%>
                            </td>

                            <td>
                                <a href="/delete-due-amount/<%=dp._id%>" onclick="return confirm('Are You Sure ?')"
                                    type="button" class="btn btn-danger btn-sm">Delete</a>

                            </td>

                        </tr>

                        <% })%>

                </tbody>
            </table>
        </div>
    </div>

    <script>
        $(document).ready(function () {
            $('#paymentTable').DataTable({
                responsive: true,
                paging: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50, 100],
                ordering: true,
                info: true,
                searching: true,
                columnDefs: [
                    { responsivePriority: 1, targets: 0 },
                    { responsivePriority: 2, targets: 1 }
                ],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ entries",
                    info: "Showing _START_ to _END_ of _TOTAL_ payments",
                    infoEmpty: "No payments found",
                    infoFiltered: "(filtered from _MAX_ total)"
                },
                dom: '<"top"lf>rt<"bottom"ip><"clear">',
            });
        });
    </script>

</body>

</html>