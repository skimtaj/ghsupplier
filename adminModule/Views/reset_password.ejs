<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Set New Password</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <style>
        /* ----- RESET & BASE ----- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
            background: #f0f4f8;
        }

        /* ----- CARD (fully responsive) ----- */
        .password-card {
            background: #ffffff;
            border-radius: 28px;
            box-shadow: 0 24px 64px -16px rgba(0, 0, 0, 0.10);
            max-width: 440px;
            width: 100%;
            padding: 36px 32px 30px 32px;
            transition: padding 0.2s;
        }

        /* ===== ENHANCED HEADING SECTION ===== */
        .heading-section {
            margin-bottom: 22px;
        }

        .heading-badge {
            display: inline-block;
            background: #eef2ff;
            color: #4f46e5;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: 0.6px;
            padding: 4px 14px;
            border-radius: 40px;
            text-transform: uppercase;
            margin-bottom: 12px;
        }

        .heading-main {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 6px;
        }

        .icon-circle {
            width: 52px;
            height: 52px;
            background: #eef2ff;
            border-radius: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: background 0.2s;
        }

        .icon-circle i {
            font-size: 24px;
            color: #4f46e5;
        }

        .heading-main h2 {
            font-size: 24px;
            font-weight: 700;
            color: #0f172a;
            letter-spacing: -0.4px;
            line-height: 1.2;
        }

        .heading-sub {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
            gap: 8px 14px;
            margin-top: 4px;
            padding-left: 66px;
        }

        .heading-sub .sub-text {
            color: #475569;
            font-size: 14px;
            font-weight: 400;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .heading-sub .sub-text i {
            color: #4f46e5;
            font-size: 13px;
        }

        .heading-sub .pill {
            background: #f1f5f9;
            color: #1e293b;
            font-size: 11px;
            font-weight: 600;
            padding: 2px 12px;
            border-radius: 50px;
            border: 1px solid #e2e8f0;
            white-space: nowrap;
        }

        /* ----- FORM ----- */
        .form-group {
            margin-bottom: 20px;
        }

        .form-group label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #1e293b;
            margin-bottom: 6px;
            letter-spacing: 0.3px;
        }

        .form-group label i {
            margin-right: 6px;
            color: #64748b;
            font-size: 12px;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .form-group input {
            width: 100%;
            padding: 12px 16px;
            padding-right: 48px;
            border: 1.5px solid #e2e8f0;
            border-radius: 14px;
            font-size: 14px;
            color: #0f172a;
            background: #f8fafc;
            outline: none;
            font-family: 'Inter', sans-serif;
            font-weight: 450;
            transition: border-color 0.2s, box-shadow 0.2s, background 0.2s;
        }

        .form-group input::placeholder {
            color: #94a3b8;
            font-weight: 400;
            font-size: 13px;
        }

        .form-group input:focus {
            border-color: #4f46e5;
            box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.08);
            background: #ffffff;
        }

        .toggle-vis {
            position: absolute;
            right: 14px;
            background: transparent;
            border: none;
            color: #94a3b8;
            font-size: 16px;
            cursor: pointer;
            padding: 4px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: color 0.2s;
        }

        .toggle-vis:hover {
            color: #4f46e5;
        }

        /* ----- BUTTONS ----- */
        .btn-row {
            display: flex;
            gap: 12px;
            margin-top: 18px;
        }

        .btn {
            flex: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 14px;
            font-size: 14px;
            font-weight: 600;
            cursor: pointer;
            font-family: 'Inter', sans-serif;
            letter-spacing: 0.2px;
            transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-primary {
            background: #4f46e5;
            color: #ffffff;
            box-shadow: 0 6px 18px rgba(79, 70, 229, 0.25);
        }

        .btn-primary:hover {
            background: #4338ca;
            transform: translateY(-2px);
            box-shadow: 0 10px 24px rgba(79, 70, 229, 0.30);
        }

        .btn-primary:active {
            transform: translateY(0);
            box-shadow: 0 4px 12px rgba(79, 70, 229, 0.20);
        }

        .btn-secondary {
            background: #f1f5f9;
            color: #475569;
            border: 1px solid #e2e8f0;
        }

        .btn-secondary:hover {
            background: #e2e8f0;
            transform: translateY(-2px);
        }

        .btn-secondary:active {
            transform: translateY(0);
        }

        /* ----- FOOTER (extra polish) ----- */
        .footer-text {
            text-align: center;
            font-size: 11px;
            color: #94a3b8;
            margin-top: 24px;
            padding-top: 18px;
            border-top: 1px solid #f1f5f9;
            letter-spacing: 0.2px;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 4px 12px;
        }

        .footer-text strong {
            color: #475569;
            font-weight: 600;
        }

        .footer-text .divider {
            color: #e2e8f0;
        }

        .footer-text .accent {
            color: #4f46e5;
            font-weight: 500;
        }

        /* ===== FULLY RESPONSIVE ===== */
        @media (max-width: 540px) {
            .password-card {
                padding: 26px 18px 22px 18px;
                border-radius: 24px;
            }

            .heading-main h2 {
                font-size: 20px;
            }

            .heading-main {
                gap: 12px;
            }

            .icon-circle {
                width: 44px;
                height: 44px;
            }

            .icon-circle i {
                font-size: 20px;
            }

            .heading-sub {
                padding-left: 0;
                margin-top: 6px;
                gap: 6px 10px;
            }

            .heading-sub .sub-text {
                font-size: 13px;
            }

            .heading-badge {
                font-size: 10px;
                padding: 3px 12px;
                margin-bottom: 10px;
            }

            .btn-row {
                flex-direction: column;
                gap: 10px;
            }

            .btn {
                padding: 14px 20px;
                font-size: 14px;
                justify-content: center;
            }

            .form-group input {
                padding: 11px 14px;
                padding-right: 44px;
                font-size: 14px;
            }

            .footer-text {
                font-size: 10px;
                flex-direction: column;
                gap: 4px;
            }
        }

        @media (max-width: 380px) {
            .password-card {
                padding: 20px 14px 18px 14px;
                border-radius: 20px;
            }

            .heading-main h2 {
                font-size: 18px;
            }

            .heading-sub .sub-text {
                font-size: 12px;
            }

            .heading-sub .pill {
                font-size: 10px;
                padding: 1px 10px;
            }

            .btn {
                font-size: 13px;
                padding: 12px 16px;
            }
        }
    </style>
</head>

<body>

    <div class="password-card">


        <div class="heading-section">
            <div class="heading-badge">
                <i class="fas fa-shield-alt" style="margin-right: 6px;"></i> secure account
            </div>

            <div class="heading-main">
                <div class="icon-circle">
                    <i class="fas fa-lock"></i>
                </div>
                <h2>Set New Password</h2>
            </div>

            <div class="heading-sub">
                <span class="sub-text">
                    Create a strong password
                </span>
                <span class="pill"><i class="fas fa-check-circle" style="color: #4f46e5; margin-right: 4px;"></i> 8+
                    chars</span>

            </div>
        </div>

        <!-- ===== FORM ===== -->
        <form id="passwordForm" autocomplete="off" method="post"
            action="/nababiamission/admin-credential/reset-password/<%=adminSourse._id%>" novalidate>

            <!-- New Password -->
            <div class="form-group">
                <label for="newPassword"><i class="fas fa-asterisk"
                        style="color: #ef4444; font-size: 8px; vertical-align: middle;"></i> New Password</label>
                <div class="input-wrapper">
                    <input type="password" id="newPassword" placeholder="Enter new password" name="new_password" />
                    <button type="button" class="toggle-vis" id="toggleNew" aria-label="Toggle password visibility">
                        <i class="fas fa-eye" id="newEyeIcon"></i>
                    </button>
                </div>
            </div>

            <!-- Buttons -->
            <div class="btn-row">
                <button type="submit" class="btn btn-primary"><i class="fas fa-arrow-right-to-bracket"></i> Update
                    Password</button>
            </div>

        </form>



    </div>

    <script>
        // 

    </script>

</body>

</html>