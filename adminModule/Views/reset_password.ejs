<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.5" />
    <title>G.H Suppliers · Reset Password</title>
    <!-- Font Awesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        /* ----- RESET & BASE ----- */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            background-color: #0d0d1a;
            background-image: url('https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?q=80&w=2070&auto=format&fit=crop');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            padding: 1.5rem;
        }

        /* Dark Overlay — deep navy with blue tint */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(10, 12, 40, 0.82);
            z-index: -1;
        }

        /* ----- MAIN CARD (Glassmorphism) — Blue accent ----- */
        .reset-card {
            width: 100%;
            max-width: 480px;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(92, 91, 239, 0.2);
            border-radius: 40px;
            padding: 2.8rem 2.2rem;
            box-shadow: 0 30px 60px -10px rgba(20, 20, 60, 0.8), 0 0 0 1px rgba(92, 91, 239, 0.08) inset;
            transition: all 0.2s ease;
        }

        /* ----- BRANDING ----- */
        .brand-area {
            display: flex;
            flex-direction: column;
            align-items: center;
            margin-bottom: 2rem;
            color: #ffffff;
        }

        .brand-avatar {
            width: 72px;
            height: 72px;
            border-radius: 50%;
            background: linear-gradient(145deg, #5C5BEF, #3d3cb8);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.8rem;
            font-weight: 700;
            box-shadow: 0 8px 24px rgba(92, 91, 239, 0.45);
            margin-bottom: 1rem;
            border: 2px solid rgba(92, 91, 239, 0.3);
            color: #ffffff;
        }

        .brand-area h1 {
            font-size: 1.6rem;
            font-weight: 600;
            letter-spacing: -0.5px;
            background: linear-gradient(to right, #c8c6ff, #8a89f5);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .brand-area p {
            font-size: 0.95rem;
            opacity: 0.7;
            font-weight: 300;
            margin-top: 0.2rem;
            color: #b0b0e8;
        }

        /* ----- FORM ----- */
        .reset-form {
            display: flex;
            flex-direction: column;
            gap: 1.6rem;
        }

        /* ----- INPUTS — with HIGHLIGHTED LABELS (blue) ----- */
        .input-group {
            position: relative;
        }

        .input-group label {
            display: block;
            font-size: 0.8rem;
            font-weight: 600;
            color: #9a99f0;
            margin-bottom: 0.5rem;
            letter-spacing: 0.6px;
            text-transform: uppercase;
            text-shadow: 0 0 14px rgba(92, 91, 239, 0.15);
            transition: color 0.3s;
        }

        .input-group label i {
            margin-right: 6px;
            color: #7a79e5;
        }

        .input-wrapper {
            position: relative;
        }

        .input-wrapper i.prefix {
            position: absolute;
            left: 0;
            top: 50%;
            transform: translateY(-50%);
            color: rgba(92, 91, 239, 0.4);
            font-size: 1rem;
            transition: color 0.3s;
            pointer-events: none;
        }

        .input-wrapper input {
            width: 100%;
            padding: 0.8rem 2.8rem 0.8rem 2.2rem;
            background: transparent;
            border: none;
            border-bottom: 1.5px solid rgba(92, 91, 239, 0.2);
            font-size: 1rem;
            color: #f0f0ff;
            outline: none;
            transition: all 0.3s ease;
        }

        .input-wrapper input:focus {
            border-bottom-color: #5C5BEF;
            box-shadow: 0 2px 12px rgba(92, 91, 239, 0.08);
        }

        .input-wrapper input:focus+i.prefix,
        .input-wrapper input:focus~.toggle-pass {
            color: #5C5BEF;
        }

        .input-wrapper input::placeholder {
            color: rgba(255, 255, 255, 0.2);
            font-weight: 300;
        }

        .input-wrapper .toggle-pass {
            position: absolute;
            right: 0;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: rgba(92, 91, 239, 0.3);
            cursor: pointer;
            transition: color 0.3s;
            font-size: 1rem;
            padding: 4px;
            z-index: 2;
        }

        .input-wrapper .toggle-pass:hover {
            color: #9a99f0;
        }

        /* password hint */
        .password-hint {
            font-size: 0.7rem;
            color: rgba(255, 255, 255, 0.25);
            margin-top: 0.3rem;
            letter-spacing: 0.2px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .password-hint i {
            color: #5C5BEF;
            opacity: 0.6;
        }

        /* ----- ACTIONS ----- */
        .btn-submit {
            width: 100%;
            padding: 1rem;
            background: linear-gradient(145deg, #5C5BEF, #3d3cb8);
            color: #ffffff;
            border: none;
            border-radius: 16px;
            font-weight: 700;
            font-size: 1rem;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(92, 91, 239, 0.35);
            letter-spacing: 0.5px;
            margin-top: 0.5rem;
        }

        .btn-submit:hover {
            background: linear-gradient(145deg, #7a79f2, #4a49c9);
            transform: scale(1.02);
            box-shadow: 0 8px 30px rgba(92, 91, 239, 0.5);
        }

        .back-link {
            text-align: center;
            margin-top: 1.5rem;
            font-size: 0.9rem;
            color: rgba(255, 255, 255, 0.45);
        }

        .back-link a {
            color: #8a89f5;
            text-decoration: none;
            font-weight: 500;
            border-bottom: 1px solid rgba(92, 91, 239, 0.2);
            transition: all 0.2s;
        }

        .back-link a:hover {
            border-bottom-color: #8a89f5;
            color: #c8c6ff;
        }

        /* ----- RESPONSIVE (MOBILE FIRST) ----- */
        @media (max-width: 600px) {
            body {
                padding: 1rem;
                align-items: flex-start;
                padding-top: 2.5rem;
            }

            .reset-card {
                padding: 2rem 1.5rem;
                border-radius: 32px;
                max-width: 100%;
            }

            .brand-avatar {
                width: 60px;
                height: 60px;
                font-size: 1.4rem;
            }

            .brand-area h1 {
                font-size: 1.4rem;
            }

            .brand-area p {
                font-size: 0.85rem;
            }

            .input-group label {
                font-size: 0.75rem;
            }

            .input-wrapper input {
                font-size: 0.9rem;
                padding: 0.7rem 2.6rem 0.7rem 2rem;
            }

            .input-wrapper i.prefix {
                font-size: 0.9rem;
            }

            .btn-submit {
                padding: 0.8rem;
                font-size: 0.95rem;
                border-radius: 14px;
            }

            .back-link {
                font-size: 0.85rem;
                margin-top: 1.2rem;
            }

            .reset-form {
                gap: 1.4rem;
            }
        }

        @media (max-width: 400px) {
            .reset-card {
                padding: 1.5rem 1rem;
            }

            .brand-area h1 {
                font-size: 1.2rem;
            }

            .input-wrapper input {
                font-size: 0.85rem;
                padding: 0.6rem 2.4rem 0.6rem 1.8rem;
            }

            .input-wrapper i.prefix {
                font-size: 0.8rem;
            }

            .btn-submit {
                font-size: 0.85rem;
                padding: 0.7rem;
            }
        }
    </style>
</head>

<body>

    <div class="reset-card">

        <!-- Branding -->
        <div class="brand-area">
            <div class="brand-avatar">G.H</div>
            <h1>Reset Password</h1>
            <p>Set a new password for your account</p>
        </div>

        <!-- Reset Password Form -->
        <form class="reset-form" method="post"  id="resetForm" action="/reset-password/<%=adminSourse._id%>">
            <!-- New Password -->
            <div class="input-group">
                <label for="newPassword"><i class="fas fa-lock" style="margin-right: 6px;"></i>New Password</label>
                <div class="input-wrapper">
                    <input type="password" id="newPassword" placeholder="Min. 8 characters" required
                        autocomplete="new-password" name="password"   />
                    <i class="fas fa-lock prefix"></i>
                    <button type="button" class="toggle-pass" onclick="togglePassword('newPassword', 'newPasswordIcon')"
                        aria-label="Toggle password visibility">
                        <i class="fas fa-eye" id="newPasswordIcon"></i>
                    </button>
                </div>
                <div class="password-hint">
                    <i class="fas fa-info-circle"></i> Must be at least 8 characters
                </div>
            </div>


            <button type="submit" class="btn-submit"><i class="fas fa-key" style="margin-right: 10px;"></i>Reset
                Password</button>

            <div class="back-link">
                <i class="fas fa-arrow-left" style="margin-right: 6px; opacity: 0.6;"></i>
                <a href="/ghsupplier/auth/login">Back to Sign In</a>
            </div>
        </form>

    </div>



</body>

</html>